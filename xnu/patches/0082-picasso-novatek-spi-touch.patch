+/* 返回匹配的表项下标，没有匹配返回 -1 */
+static inline int
+nvt_trim_match(const uint8_t *id)
+{
+	for (unsigned t = 0; t < sizeof(nvt_trim_table) / sizeof(nvt_trim_table[0]); ++t) {
+		unsigned i;
+		for (i = 0; i < NVT_ID_BYTES; ++i) {
+			if (nvt_trim_table[t].mask[i] && id[i] != nvt_trim_table[t].id[i]) {
+				break;
+			}
+		}
+		if (i == NVT_ID_BYTES) {
+			return (int)t;
+		}
+	}
+	return -1;
+}
+
+static inline uint32_t
+nvt_le32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+/* 一个分区：写到芯片 SRAM 的 sram 地址，内容是固件文件 bin 偏移处的 size+1 字节
+ * （厂商在写入时把 size 加 1）；crc 是硬件 CRC 方式的期望值。 */
+struct nvt_part {
+	uint32_t sram, size, bin, crc;
+};
+
+struct nvt_fw {
+	const uint8_t *data;
+	uint32_t size, need;     /* 文件大小；带结束标志的有效长度 */
+	uint8_t ver;             /* 固件版本（有效长度 - 4 KiB 处） */
+	unsigned nparts, ninfo, novly;
+	struct nvt_part part[NVT_MAX_PARTS];
+};
+
+#define NVT_FW_OK          0
+#define NVT_FW_SHORT      -1
+#define NVT_FW_NO_FLAG    -2
+#define NVT_FW_BAD_VER    -3
+#define NVT_FW_NO_HWCRC   -4
+#define NVT_FW_BAD_HEADER -5
+#define NVT_FW_BAD_RANGE  -6
+
+static inline const char *
+nvt_fw_error(int e)
+{
+	switch (e) {
+	case NVT_FW_OK:         return "ok";
+	case NVT_FW_SHORT:      return "file too short";
+	case NVT_FW_NO_FLAG:    return "no NVT/MOD end flag";
+	case NVT_FW_BAD_VER:    return "FW_VER + FW_VER_BAR != 0xFF";
+	case NVT_FW_NO_HWCRC:   return "chip needs software checksum download (unsupported)";
+	case NVT_FW_BAD_HEADER: return "bad bin header";
+	case NVT_FW_BAD_RANGE:  return "partition outside the file";
+	default:                return "?";
+	}
+}
+
+/*
+ * 检查并解析固件文件，等价于厂商 update_firmware_request() 里的
+ * nvt_get_fw_need_write_size()、FW_VER 检查和 nvt_bin_header_parser()（hw_crc 方式），
+ * 另外补上厂商没有做的越界检查。成功返回 NVT_FW_OK。
+ */
+static inline int
+nvt_fw_parse(const uint8_t *d, uint32_t size, unsigned hw_crc, struct nvt_fw *fw)
+{
+	fw->data = d;
+	fw->size = size;
+	fw->need = 0;
+	fw->nparts = fw->ninfo = fw->novly = 0;
+	if (!d || size < NVT_SECTOR) {
+		return NVT_FW_SHORT;
+	}
+	/* 从后往前找以 "NVT" 或 "MOD" 结尾的 4 KiB 扇区 */
+	for (uint32_t i = size / NVT_SECTOR; i > 0; --i) {
+		const uint8_t *f = d + i * NVT_SECTOR - 3;
+		if ((f[0] == 'N' && f[1] == 'V' && f[2] == 'T') ||
+		    (f[0] == 'M' && f[1] == 'O' && f[2] == 'D')) {
+			fw->need = i * NVT_SECTOR;
+			break;
+		}
+	}
+	if (!fw->need) {
+		return NVT_FW_NO_FLAG;
+	}
+	if (fw->need < NVT_SECTOR ||
+	    ((d[fw->need - NVT_SECTOR] + d[fw->need - NVT_SECTOR + 1]) & 0x1ff) != 0xFF) {
+		return NVT_FW_BAD_VER;
+	}
+	fw->ver = d[fw->need - NVT_SECTOR];
+	if (!hw_crc) {
+		return NVT_FW_NO_HWCRC;
+	}
+	/* 头部长度（第 0 个字），信息段从 0x30 起每段 16 字节 */
+	uint32_t end = nvt_le32(d);
+	if (end > size) {
+		return NVT_FW_BAD_HEADER;
+	}
+	unsigned info = 0;
+	for (uint32_t pos = 0x30; pos < end; pos += 0x10) {
+		++info;
+	}
+	unsigned ovly = (d[0x28] & 0x10) ? (d[0x28] & 0x0Fu) : 0;
+	unsigned total = 2u + ovly + info;
+	if (total > NVT_MAX_PARTS || 0x30u + 0x10u * info > size) {
+		return NVT_FW_BAD_HEADER;
+	}
+	for (unsigned l = 0; l < total; ++l) {
+		struct nvt_part *p = &fw->part[l];
+		if (l < 2) {
+			/* ILM、DLM：BIN_addr、SRAM_addr、size 各 4 字节，CRC 在 0x18/0x1C */
+			p->bin = nvt_le32(d + l * 12u);
+			p->sram = nvt_le32(d + 4u + l * 12u);
+			p->size = nvt_le32(d + 8u + l * 12u);
+			p->crc = nvt_le32(d + 0x18u + l * 4u);
+		} else {
+			uint64_t pos;
+			if (l < 2u + info) {
+				pos = 0x30u + 0x10u * (l - 2u);
+			} else {
+				/* 覆盖段的描述放在 DLM 的起始处 */
+				pos = (uint64_t)fw->part[1].bin + 0x10u * (l - 2u - info);
+			}
+			if (pos + 16u > size) {
+				return NVT_FW_BAD_HEADER;
+			}
+			p->sram = nvt_le32(d + pos);
+			p->size = nvt_le32(d + pos + 4u);
+			p->bin = nvt_le32(d + pos + 8u);
+			p->crc = nvt_le32(d + pos + 12u);
+		}
+		/* 厂商检查 BIN_addr + size <= 文件大小；实际要写 size+1 字节，这里按 size+1 查 */
+		if (p->size && ((uint64_t)p->bin + p->size + 1u > size ||
+		    (uint64_t)p->sram + p->size + 1u > 0x800000u)) {
+			return NVT_FW_BAD_RANGE;
+		}
+	}
+	fw->nparts = total;
+	fw->ninfo = info;
+	fw->novly = ovly;
+	return NVT_FW_OK;
+}
+
+/* 固件信息（事件缓冲区 0x78 起 16 字节）：版本与反码校验，坐标最大值是大端 */
+struct nvt_fwinfo {
+	uint8_t ver, x_num, y_num, type;
+	unsigned xmax, ymax;
+};
+
+static inline int
+nvt_parse_fwinfo(const uint8_t *d, struct nvt_fwinfo *fi)
+{
+	if (((d[0] + d[1]) & 0x1ff) != 0xFF) {
+		return 0;
+	}
+	fi->ver = d[0];
+	fi->x_num = d[2];
+	fi->y_num = d[3];
+	fi->xmax = ((unsigned)d[4] << 8) | d[5];
+	fi->ymax = ((unsigned)d[6] << 8) | d[7];
+	fi->type = d[13];
+	return 1;
+}
+
+/* 一帧报点。mask 第 i 位 = 手指 i（芯片 ID i+1）按下 */
+struct nvt_points {
+	uint32_t mask;
+	unsigned x[NVT_MAX_FINGERS], y[NVT_MAX_FINGERS];
+};
+
+/*
+ * 解析事件缓冲区开头 65 字节（厂商 point_data[1..65]）。每个手指 6 字节：
+ * [0] = ID<<3 | 状态（1 进入、2 移动 = 按下），x = [1]<<4 | [3]>>4，y = [2]<<4 | [3]&0xF。
+ * 和厂商一样跳过 ID 为 0 或大于 10、以及坐标超出固件给的最大值的记录。返回按下的手指数。
+ */
+static inline unsigned
+nvt_parse_points(const uint8_t *d, unsigned xmax, unsigned ymax, struct nvt_points *pt)
+{
+	unsigned n = 0;
+	pt->mask = 0;
+	for (unsigned i = 0; i < NVT_MAX_FINGERS; ++i) {
+		const uint8_t *p = d + 6u * i;
+		unsigned id = p[0] >> 3, st = p[0] & 7u;
+		if (id == 0 || id > NVT_MAX_FINGERS || (st != 1u && st != 2u)) {
+			continue;
+		}
+		unsigned x = ((unsigned)p[1] << 4) | (p[3] >> 4);
+		unsigned y = ((unsigned)p[2] << 4) | (p[3] & 0x0Fu);
+		if (x > xmax || y > ymax) {
+			continue;
+		}
+		if (!(pt->mask & (1u << (id - 1)))) {
+			++n;
+		}
+		pt->mask |= 1u << (id - 1);
+		pt->x[id - 1] = x;
+		pt->y[id - 1] = y;
+	}
+	return n;
+}
+
+/* 看门狗复位后的帧：前 6 字节都是 0xFD/0xFE（厂商 nvt_wdt_fw_recovery） */
+static inline int
+nvt_is_wdt_frame(const uint8_t *d)
+{
+	for (unsigned i = 0; i < 6; ++i) {
+		if (d[i] != 0xFD && d[i] != 0xFE) {
+			return 0;
+		}
+	}
+	return 1;
+}
+
+/* 固件的 ESD 心跳帧：前 6 字节都是 0x77（厂商 nvt_fw_recovery） */
+static inline int
+nvt_is_esd_frame(const uint8_t *d)
+{
+	for (unsigned i = 0; i < 6; ++i) {
+		if (d[i] != 0x77) {
+			return 0;
+		}
+	}
+	return 1;
+}
+
+/* 固件坐标（0..max）换算成屏幕像素（0..screen-1） */
+static inline unsigned
+nvt_scale(unsigned v, unsigned max, unsigned screen)
+{
+	unsigned s = max ? (unsigned)(((uint64_t)v * screen) / ((uint64_t)max + 1u)) : v;
+	return s < screen ? s : screen - 1u;
+}
+
+/*
+ * 在 ADT 的 panel-fw 表里查面板对应的固件属性名。表是若干个以 NUL 结尾的
+ * "面板=属性名" 字符串，例如 "37_02_0a=fw01\0"。找到返回 1，结果写进 out。
+ */
+static inline int
+nvt_panel_lookup(const char *map, unsigned len, const char *panel, char *out, unsigned outlen)
+{
+	unsigned i = 0;
+	if (!outlen) {
+		return 0;
+	}
+	out[0] = 0;
+	while (i < len) {
+		const char *e = map + i;
+		unsigned n = 0;
+		while (i + n < len && e[n]) {
+			++n;
+		}
+		unsigned k = 0;
+		while (panel[k] && k < n && e[k] == panel[k]) {
+			++k;
+		}
+		if (!panel[k] && k < n && e[k] == '=') {
+			unsigned m = 0;
+			for (unsigned j = k + 1; j < n && m + 1 < outlen; ++j) {
+				out[m++] = e[j];
+			}
+			out[m] = 0;
+			return m != 0;
+		}
+		i += n + 1;
+	}
+	return 0;
+}
