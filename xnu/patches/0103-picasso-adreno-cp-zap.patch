+/* ---------------------------------------------------------------- 14. TrustZone */
+
+/*
+ * 3D 核心上电时处于"安全模式"，只有 TrustZone 能放它出来：交给 TZ 校验并运行厂商签名的 zap shader
+ * （原厂设备树 qcom,kgsl-hyp：pil-tz-generic、qcom,pas-id 13、a620_zap；内存 pil_gpu_region@8bc15400 0x2000）。
+ * 调用约定照 HackiOS（Linux qcom_scm-smc.c）：SMC64、SIP、服务 2（PAS）。
+ */
+#define SCM_FAST                (1ull << 31)
+#define SCM_64                  (1ull << 30)
+#define SCM_SIP                 (2ull << 24)
+#define SCM_CALL(service, command) ((uint64_t)(service) << 8 | (command))
+#define SCM_IS_CALL_AVAILABLE   SCM_CALL(6, 1)
+#define SCM_PAS_INIT_IMAGE      SCM_CALL(2, 1)
+#define SCM_PAS_MEM_SETUP       SCM_CALL(2, 2)
+#define SCM_PAS_AUTH_AND_RESET  SCM_CALL(2, 5)
+#define SCM_PAS_SHUTDOWN        SCM_CALL(2, 6)
+#define SCM_PAS_IS_SUPPORTED    SCM_CALL(2, 7)
+#define SCM_ONE_VALUE           1
+#define SCM_THREE_VALUES        3
+#define SCM_VALUE_AND_BUFFER    (2 | 2 << 6)
+#define SCM_INTERRUPTED         1
+#define PAS_GPU                 13
+#define ZAP_MEMORY              0x8bc15400ull
+#define ZAP_MEMORY_SIZE         0x2000u
+
+static int32_t
+scm(const char *what, uint64_t function, uint64_t arguments, uint64_t first, uint64_t second, uint64_t third,
+    uint64_t *answer)
+{
+	uint64_t session = 0;
+	printf(TAG ": %u: ask TrustZone %s: smc %#llx (%#llx, %#llx, %#llx)\n", step, what, function, first, second, third);
+	snprintf(last_write, sizeof(last_write), "step %u asked TrustZone %#llx", step, function);
+	for (int i = 0; i < 100; i++) {
+		register uint64_t x0 __asm__("x0") = i == 0 ? function : SCM_INTERRUPTED;
+		register uint64_t x1 __asm__("x1") = arguments;
+		register uint64_t x2 __asm__("x2") = first;
+		register uint64_t x3 __asm__("x3") = second;
+		register uint64_t x4 __asm__("x4") = third;
+		register uint64_t x5 __asm__("x5") = 0;
+		register uint64_t x6 __asm__("x6") = session;
+		register uint64_t x7 __asm__("x7") = 0;
+		__asm__ volatile ("smc #0" : "+r" (x0), "+r" (x1), "+r" (x2), "+r" (x3), "+r" (x4), "+r" (x5), "+r" (x6),
+		    "+r" (x7) : : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+		session = x6;
+		if (x0 != SCM_INTERRUPTED) {
+			printf(TAG ": %u: TrustZone returns %d, answer %#llx\n", step, (int32_t)x0, x1);
+			*answer = x1;
+			return (int32_t)x0;
+		}
+	}
+	printf(TAG ": %u: TrustZone keeps saying the call was interrupted\n", step);
+	return -1;
+}
+
+static uint64_t scm_how = SCM_FAST | SCM_64 | SCM_SIP;
+static uint32_t no_zap;
+
+static bool
+step_tz(void)
+{
+	uint64_t answer = 0;
+	(void)PE_parse_boot_argn("picassonozap", &no_zap, sizeof(no_zap));
+	if (no_zap) {
+		printf(TAG ": %u: picassonozap=1: TrustZone is not asked\n", step);
+		return true;
+	}
+	announce("ask TrustZone whether it takes calls from this kernel, and whether it supports the GPU's image (13)");
+	if (scm("whether it can be asked", scm_how | SCM_IS_CALL_AVAILABLE, SCM_ONE_VALUE, SCM_SIP | SCM_IS_CALL_AVAILABLE,
+	    0, 0, &answer) != 0 || answer != 1) {
+		scm_how = SCM_FAST | SCM_SIP;
+		if (scm("the same, 32-bit", scm_how | SCM_IS_CALL_AVAILABLE, SCM_ONE_VALUE, SCM_SIP | SCM_IS_CALL_AVAILABLE,
+		    0, 0, &answer) != 0 || answer != 1) {
+			printf(TAG ": %u: TrustZone does not answer the way it answers Linux\n", step);
+			return false;
+		}
+	}
+	scm("for PAS init image", scm_how | SCM_IS_CALL_AVAILABLE, SCM_ONE_VALUE, SCM_SIP | SCM_PAS_INIT_IMAGE, 0, 0, &answer);
+	scm("for PAS auth and reset", scm_how | SCM_IS_CALL_AVAILABLE, SCM_ONE_VALUE, SCM_SIP | SCM_PAS_AUTH_AND_RESET, 0, 0,
+	    &answer);
+	answer = 0;
+	scm("whether image 13 (GPU) is supported", (scm_how & ~SCM_FAST) | SCM_PAS_IS_SUPPORTED, SCM_ONE_VALUE, PAS_GPU, 0, 0,
+	    &answer);
+	return true;
+}
