+/* ---------------------------------------------------------------------------
+ * 4. PIPE 时钟改走 UTMI：设备树 maximum-speed = "high-speed"，没有 SS PHY，DWC3 的
+ * PIPE 时钟域没有时钟，端点命令就一直不完成（另一台 K30 5G 的 Run 6/18-20）。
+ * 在控制器软复位之后调用（dwc3-msm.c 是在 POST_RESET 事件里做的）。
+ * ------------------------------------------------------------------------- */
+void
+picasso_usb_utmi_select(vm_offset_t qs)
+{
+	int mode = 1;
+	(void)PE_parse_boot_argn("sweetusbutmi", &mode, sizeof(mode));
+	uint32_t cfg = pu_rd(qs, QS_GENERAL_CFG);
+	bool selected = (cfg & (PIPE_UTMI_CLK_SEL | PIPE3_PHYSTATUS_SW)) == (PIPE_UTMI_CLK_SEL | PIPE3_PHYSTATUS_SW);
+	if (mode == 0 || (mode == 1 && selected)) {
+		printf("SWEET USB: GENERAL_CFG 0x%08x left as is (UTMI clock %s, sweetusbutmi=%d)\n",
+		    cfg, selected ? "selected" : "NOT selected", mode);
+		return;
+	}
+	/* 先停掉 PIPE/UTMI 时钟，再切选择，再放开，避免切换时出毛刺（与 dwc3-msm.c 相同） */
+	pu_wr(qs, QS_GENERAL_CFG, pu_rd(qs, QS_GENERAL_CFG) | PIPE_UTMI_CLK_DIS);
+	delay(5);
+	pu_wr(qs, QS_GENERAL_CFG, pu_rd(qs, QS_GENERAL_CFG) | PIPE_UTMI_CLK_SEL | PIPE3_PHYSTATUS_SW);
+	delay(5);
+	pu_wr(qs, QS_GENERAL_CFG, pu_rd(qs, QS_GENERAL_CFG) & ~PIPE_UTMI_CLK_DIS);
+	printf("SWEET USB: GENERAL_CFG 0x%08x -> 0x%08x (PIPE clock from UTMI)\n", cfg, pu_rd(qs, QS_GENERAL_CFG));
+}
