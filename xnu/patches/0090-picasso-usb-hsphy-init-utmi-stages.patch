+/* 返回 0：可以继续启动控制器；非 0：PHY 不能用，不要再碰控制器 */
+int
+picasso_usbphy_prepare(void)
+{
+	int mode = 1, vote = 0, smmu = 0;
+	(void)PE_parse_boot_argn("sweetusbphy", &mode, sizeof(mode));
+	(void)PE_parse_boot_argn("sweetusbvreg", &vote, sizeof(vote));
+	(void)PE_parse_boot_argn("sweetusbsmmu", &smmu, sizeof(smmu));
+
+	if (smmu) {
+		pu_smmu_report(smmu);
+	}
+	pu_rails_check(vote);
+
+	vm_offset_t gcc = ml_io_map(PU_GCC_PA, PU_GCC_SIZE);
+	vm_offset_t eud = ml_io_map(PU_EUD_PA, PU_EUD_SIZE);
+	pu_phy = ml_io_map(PU_PHY_PA, PU_PHY_SIZE);
+	if (gcc == 0 || eud == 0 || pu_phy == 0) {
+		printf("SWEET USB: HSPHY map failed\n");
+		return -1;
+	}
+	/* usb30_prim GDSC 开着，PHY 的 APB 才应答；ABL 一般已开。位 0 = SW_COLLAPSE，
+	 * **绝不能写**（另一台 K30 的 Run 22 写它把 USB 电源域关了，直接 panic）；位 31 = 只读供电状态。 */
+	uint32_t gdsc = pu_rd(gcc, PU_GDSCR);
+	printf("SWEET USB: usb30_prim GDSC 0x%08x (%s)\n", gdsc, (gdsc & (1u << 31)) ? "on" : "OFF");
+	/* lito 没有独立的 ahb2phy 分支时钟（0x6a004 CBCR 不是闸门，写它无效，另一台 K30 Run 21/24）；
+	 * 桥由 GCC_USB_PHY_CFG_AHB2PHY_BCR（0x6a000）的复位位管，复位没放开就放开它。 */
+	uint32_t bcr = pu_rd(gcc, PU_AHB2PHY_BCR);
+	if (bcr & 3u) {
+		pu_wr(gcc, PU_AHB2PHY_BCR, bcr & ~3u);
+		delay(1000);
+	}
+	printf("SWEET USB: ahb2phy BCR 0x%08x -> 0x%08x, CBCR 0x%08x\n",
+	    bcr, pu_rd(gcc, PU_AHB2PHY_BCR), pu_rd(gcc, PU_AHB2PHY_CBCR));
+	/* EUD（嵌入式 USB 调试）打开时 PHY 归 EUD 管，原厂驱动直接返回成功，不碰 PHY */
+	uint32_t eud_en = pu_rd(eud, 0);
+	if (eud_en) {
+		printf("SWEET USB: EUD enabled (0x%08x); HSPHY left alone\n", eud_en);
+		return 0;
+	}
+
+	pu_phy_dump("before");
+	bool good = pu_phy_initialized();
+	if (mode == 0 || (mode == 1 && good)) {
+		printf("SWEET USB: HSPHY %s; not reset (sweetusbphy=%d)\n",
+		    good ? "already initialized" : "NOT initialized", mode);
+		return 0;
+	}
+	pu_phy_init(gcc);
+	pu_phy_dump("after");
+	good = pu_phy_initialized();
+	printf("SWEET USB: HSPHY reset + init %s (%u readback errors)\n", good ? "done" : "FAILED", pu_phy_errors);
+	return good ? 0 : -1;
+}
