+++ b/bsd/dev/picasso_usbphy.c
@@ -0,0 +1,435 @@
+/*
+ * picasso（红米 K30 5G，SM7250）USB 设备模式的准备工作，由 sweet_usb.c 的
+ * sweet_usb_gadget_start() 调用（只在 sweetusb=2 时）：
+ *   1. 报告 USB 流（SID 0xe0）在 apps SMMU 里的配置（只读）；
+ *   2. 报告 HS PHY 三路电源（PM8150 L5A/L12A/L2A，SPMI 只读），可选 RPMh 投票；
+ *   3. Synopsys femto HS PHY（hsphy@88e3000）：EUD 检查、ahb2phy 时钟、复位 + 初始化；
+ *   4. 控制器软复位之后，把 DWC3 的 PIPE 时钟换成 UTMI 时钟（只有 USB 2.0 时必须）。
+ *
+ * 来源：
+ *   原厂设备树 hsphy@88e3000："qcom,usb-hsphy-snps-femto"，reg <0x88e3000 0x110>（PHY）和
+ *     <0x88e2000 0x4>（EUD 使能）；vdd = pm8150_l5（ldoa5，qcom,vdd-voltage-level 880000）、
+ *     vdda18 = pm8150_l12（ldoa12）、vdda33 = pm8150_l2（ldoa2）；resets = GCC 第 15 号
+ *     （gcc-lito.c：GCC_QUSB2PHY_PRIM_BCR 0x12000）；qcom,param-override-seq =
+ *     <0xc8 0x70 0x24 0x74 0x64 0x6c>（值, 偏移）。
+ *   原厂设备树 ssusb@a600000：iommus = <&apps_smmu 0xe0 0x0>；dwc3 子节点
+ *     maximum-speed = "high-speed"、usb-phy = <hsphy, usb_nop_phy>、snps,disable-clk-gating。
+ *   小米 picasso-r-oss：drivers/usb/phy/phy-msm-snps-hs.c 的 msm_hsphy_init()、msm_hsphy_reset()；
+ *     drivers/usb/dwc3/dwc3-msm.c 的 DWC3_CONTROLLER_POST_RESET_EVENT（只有高速/全速时
+ *     QSCRATCH_GENERAL_CFG：PIPE_UTMI_CLK_DIS -> PIPE_UTMI_CLK_SEL | PIPE3_PHYSTATUS_SW -> 清 DIS）。
+ *   ARM SMMUv2 / MMU-500 寄存器（Linux drivers/iommu/arm-smmu.h）。
+ *
+ * 另一台 K30 5G 的真机日志（github.com/minhtritt1996/ios-picasso，NOTES Run 6-21）：
+ *   - PHY 寄存器是 8 位的，经 ahb2phy 桥读出来每个字节重复四次：0x01010101、0x06060606、
+ *     0x88888888 就是 0x01、0x06、0x88。写入是生效的（Run 19 写 COMMON0 后读回 0xb0b0b0b0）。
+ *     ahb2phy 的 CBCR 读到 0x80000002（位 1 = 硬件控制，空闲时自动关），这时照样能读写。
+ *   - ABL 之后 PHY 已经是初始化好的样子：UTMI_CTRL0 SLEEPM=1、UTMI_CTRL5 POR=0、
+ *     CTRL2 SUSPEND_N=1。Run 20 做了完整的复位 + 初始化，没有出问题。
+ *   - 不切 UTMI 时钟时 ep0 的 SETEPCONFIG 一直超时（Run 6、18、19、20）；切了以后不超时
+ *     （Run 7，GENERAL_CFG 读回 0xd）。但切了的那几次（Run 7、11、17）都在 2-3 秒后整机重启。
+ *     那几次也正是控制器真正跑起来（ep0 配好、TRB 交给控制器、RUN_STOP）的几次，所以分不清
+ *     是写 GENERAL_CFG 本身，还是之后的 DMA / 中断。sweet_usb.c 的 sweetusbstage=N 能在每一步
+ *     之后停下来，一次只多走一步，用来在真机上找出是哪一步。
+ *   - 2026-10-24 omp 分支把原因缩到了一步：PHY、电源、UTMI 都做完、ep0 配置成功、电脑看到高速连接后，
+ *     控制器**第一次 DMA（STARTTRANSFER）**手机就断电重启，换低位内存也一样。他们判断是 apps SMMU
+ *     把 USB 流（SID 0xe0）拦下了。但他们用的是 SMMUv3 的偏移（S2CR 写到 0x8700、TYPE 放错位），
+ *     **正确的 SMMUv2 旁路从没试过**。所以这里的 SMMU 用正确偏移（SMR 0x800+4n、S2CR 0xc00+4n、
+ *     TYPE 在位[17:16]），sweetusbsmmu=2 时把 SID 0xe0 改成旁路——这是让 USB DMA 能跑的候选修法。
+ *     HackiOS（oosexgang，APSL 2.0）在同类芯片上证明：这些全局寄存器由高通虚拟机监控器代管，
+ *     只能用最简单的 ldr/str（不能 str wzr），所以 pu_rd/pu_wr 用显式内联汇编。
+ *
+ * boot-args（都只在 sweetusb=2 时起作用）：
+ *   sweetusbphy=0|1|2   0 只报告 PHY；1（默认）PHY 不是 Linux 初始化后的样子才复位重来；2 总是复位重来
+ *   sweetusbutmi=0|1|2  0 不动 GENERAL_CFG；1（默认）还没选 UTMI 时钟才切；2 总是按 Linux 顺序走一遍
+ *   sweetusbvreg=0|1|2  0（默认）只报告三路电源；1 读到没电的那路才 RPMh 投票；2 三路都投票
+ *   sweetusbsmmu=0|1|2  0（默认）不碰 SMMU；1 只读报告 SID 0xe0 的配置（读上百个寄存器有卡总线风险）；
+ *                       2 还把 SID 0xe0 改成旁路（候选修法，真机未验证）
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include "sweet_spmi.h"
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern int sweet_rpmh_vreg_enable(const char *res, unsigned mv);	/* bsd/dev/sweet_rpmh.c */
+int picasso_usbphy_prepare(void);
+void picasso_usb_utmi_select(vm_offset_t qscratch);
+
+/* GCC（与 sweet_usb.c 相同的映射范围） */
+#define PU_GCC_PA               0x00100000
+#define PU_GCC_SIZE             0x00090000
+#define PU_AHB2PHY_BCR          0x6a000         /* GCC_USB_PHY_CFG_AHB2PHY_BCR，位 0/1 = 复位 */
+#define PU_AHB2PHY_CBCR         0x6a004         /* lito 没把它当闸门用；只读着看，别写（另一台 K30 Run 21/24） */
+#define PU_GDSCR                0x0f004         /* GCC_USB30_PRIM_GDSCR，位 0 SW_COLLAPSE（只读不写），位 31 供电状态 */
+#define PU_HSPHY_BCR            0x12000         /* GCC_QUSB2PHY_PRIM_BCR，位 0 = 复位 */
+#define PU_CBCR_EN              (1u << 0)
+#define PU_CBCR_OFF             (1u << 31)
+
+/* HS PHY 与 EUD（原厂设备树 hsphy@88e3000） */
+#define PU_PHY_PA               0x088e3000
+#define PU_PHY_SIZE             0x00000110
+#define PU_EUD_PA               0x088e2000
+#define PU_EUD_SIZE             0x00000004
+
+/* phy-msm-snps-hs.c 的寄存器（8 位） */
+#define UTMI_CTRL0              0x3c
+#define   SLEEPM                (1u << 0)
+#define UTMI_CTRL5              0x50
+#define   POR                   (1u << 1)
+#define CTRL_COMMON0            0x54
+#define   FSEL_MASK             (7u << 4)
+#define CTRL_COMMON1            0x58
+#define   VBUSVLDEXTSEL0        (1u << 4)
+#define   PLLBTUNE              (1u << 5)
+#define CTRL_COMMON2            0x5c
+#define   VREGBYPASS            (1u << 0)
+#define CTRL1                   0x60
+#define   VBUSVLDEXT0           (1u << 0)
+#define CTRL2                   0x64
+#define   USB2_SUSPEND_N        (1u << 2)
+#define   USB2_SUSPEND_N_SEL    (1u << 3)
+#define OVERRIDE_X0             0x6c
+#define OVERRIDE_X1             0x70
+#define OVERRIDE_X2             0x74
+#define OVERRIDE_X3             0x78
+#define PHY_CFG0                0x94
+#define   CMN_CTRL_OVERRIDE_EN  (1u << 1)
+#define REFCLK_CTRL             0xa0
+#define   REFCLK_SEL_MASK       (3u << 0)
+#define   REFCLK_SEL_DEFAULT    (2u << 0)
+
+/* 原厂设备树 qcom,param-override-seq：<值 偏移> 成对，按顺序写 */
+static const uint8_t pu_override_seq[][2] = {
+	{ 0xc8, OVERRIDE_X1 },
+	{ 0x24, OVERRIDE_X2 },
+	{ 0x64, OVERRIDE_X0 },
+};
+
+/* QSCRATCH_GENERAL_CFG（DWC3 + 0xf8808，dwc3-msm.c） */
+#define QS_GENERAL_CFG          0x08
+#define   PIPE_UTMI_CLK_SEL     (1u << 0)
+#define   PIPE3_PHYSTATUS_SW    (1u << 3)
+#define   PIPE_UTMI_CLK_DIS     (1u << 8)
+
+/* apps SMMU（原厂设备树 apps-smmu@15000000，reg 大小 0x100000，"qcom,qsmmu-v500"） */
+#define PU_SMMU_PA              0x15000000
+#define PU_SMMU_SIZE            0x00100000
+#define PU_USB_SID              0xe0u
+
+/* 显式的单条 ldr/str：SMMU 全局寄存器由高通虚拟机监控器代管，只认最简单的指令形式
+ * （HackiOS 的结论），所以不让编译器自选 dc zva 之类。 */
+static uint32_t
+pu_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v;
+	__asm__ volatile ("ldr %w0, [%1]" : "=r"(v) : "r"(base + off) : "memory");
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+pu_wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	__asm__ volatile ("str %w0, [%1]" :: "r"(v), "r"(base + off) : "memory");
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/* ---------------------------------------------------------------------------
+ * 1. SMMU（smmu=1 只读报告，smmu=2 还旁路）。USB 控制器的 DMA（事件缓冲、TRB、数据）都经过 apps SMMU。
+ * 另一台 K30 的真机结论：控制器第一次 DMA 就被 SMMU 拦下，整机重启。UEFI 的 UsbConfigDxe 给 USB
+ * 建过一个 "HAL IOMMU usb domain"，退出时是否拆掉不知道；SID 0xe0 可能指向一个会 fault 的上下文。
+ * 这里把匹配 SID 0xe0 的 SMR/S2CR 和它的上下文打印出来；smmu=2 时把 S2CR 改成旁路（TYPE=1），
+ * 让控制器的 DMA 直接用物理地址。写用显式 str（见 pu_wr）。
+ * ------------------------------------------------------------------------- */
+static void
+pu_smmu_report(int smmu)
+{
+	vm_offset_t s = ml_io_map(PU_SMMU_PA, PU_SMMU_SIZE);
+	if (s == 0) {
+		printf("SWEET USB: SMMU map failed\n");
+		return;
+	}
+	uint32_t scr0 = pu_rd(s, 0x00), id0 = pu_rd(s, 0x20), id1 = pu_rd(s, 0x24);
+	unsigned nsmr = id0 & 0xffu, ncb = id1 & 0xffu;
+	unsigned pgshift = (id1 & (1u << 31)) ? 16 : 12;
+	unsigned npage = 1u << (((id1 >> 28) & 7u) + 1);
+	bool exids = (id0 & (1u << 8)) && (scr0 & (1u << 3));
+	printf("SWEET USB: SMMU sCR0 0x%08x (CLIENTPD %u USFCFG %u) IDR0 0x%08x IDR1 0x%08x: %u SMR, %u CB, %u KiB pages x %u\n",
+	    scr0, scr0 & 1u, (scr0 >> 10) & 1u, id0, id1, nsmr, ncb, 1u << (pgshift - 10), npage);
+	if (scr0 == 0xffffffffu || id0 == 0xffffffffu || nsmr == 0 || nsmr > 128) {
+		printf("SWEET USB: SMMU registers unreadable or unexpected; no SMR scan\n");
+		return;
+	}
+	/* 上下文银行在 base + npage 页处；超出设备树给的 1 MiB 就不读 */
+	bool cb_ok = ((uint64_t)(2u * npage) << pgshift) <= PU_SMMU_SIZE;
+	unsigned matches = 0;
+	for (unsigned i = 0; i < nsmr; i++) {
+		uint32_t smr = pu_rd(s, 0x800 + 4 * i), s2cr = pu_rd(s, 0xc00 + 4 * i);
+		bool valid;
+		uint32_t id, mask;
+		if (exids) {
+			valid = (s2cr >> 10) & 1u;
+			id = smr & 0xffffu;
+			mask = smr >> 16;
+		} else {
+			valid = smr >> 31;
+			id = smr & 0x7fffu;
+			mask = (smr >> 16) & 0x7fffu;
+		}
+		if (!valid || ((id ^ PU_USB_SID) & ~mask & 0xffffu) != 0) {
+			continue;
+		}
+		matches++;
+		unsigned type = (s2cr >> 16) & 3u, cb = s2cr & 0xffu;
+		static const char *const s2cr_type[] = { "translate", "bypass", "fault", "reserved" };
+		printf("SWEET USB: SMMU SMR%u id 0x%x mask 0x%x -> S2CR 0x%08x (%s, CB %u)\n",
+		    i, id, mask, s2cr, s2cr_type[type], cb);
+		if (smmu >= 2 && type != 1) {
+			/* SMMUv2：S2CR.TYPE 在位[17:16]，1 = BYPASS。改成旁路 = USB DMA 走物理地址。 */
+			uint32_t want = (s2cr & ~(3u << 16)) | (1u << 16);
+			pu_wr(s, 0xc00 + 4 * i, want);
+			printf("SWEET USB: SMMU SMR%u S2CR 0x%08x -> 0x%08x (bypass, sweetusbsmmu=2)\n",
+			    i, s2cr, pu_rd(s, 0xc00 + 4 * i));
+		}
+		if (type != 0 || cb >= ncb || !cb_ok) {
+			continue;
+		}
+		uint32_t cbar = pu_rd(s, (1u << pgshift) + 4 * cb);
+		vm_offset_t c = s + ((vm_offset_t)npage << pgshift) + ((vm_offset_t)cb << pgshift);
+		uint32_t sctlr = pu_rd(c, 0x00), tcr = pu_rd(c, 0x30), fsr = pu_rd(c, 0x58);
+		uint64_t ttbr0 = pu_rd(c, 0x20) | ((uint64_t)pu_rd(c, 0x24) << 32);
+		uint64_t far = pu_rd(c, 0x60) | ((uint64_t)pu_rd(c, 0x64) << 32);
+		static const char *const cbar_type[] = { "S2 only", "S1, S2 bypass", "S1, S2 fault", "nested" };
+		printf("SWEET USB: SMMU CB%u CBAR 0x%08x (%s, VMID %u) SCTLR 0x%08x (M %u CFCFG %u) TCR 0x%08x TTBR0 0x%016llx FSR 0x%08x FAR 0x%016llx\n",
+		    cb, cbar, cbar_type[(cbar >> 16) & 3u], cbar & 0xffu, sctlr, sctlr & 1u, (sctlr >> 7) & 1u,
+		    tcr, ttbr0, fsr, far);
+		if (sctlr & 1u) {
+			printf("SWEET USB: SMMU: USB DMA goes through stage-1 page tables at 0x%llx (left by UEFI?)\n",
+			    ttbr0 & 0x0000fffffffff000ULL);
+		}
+	}
+	if (matches == 0) {
+		printf("SWEET USB: SMMU: no SMR matches SID 0x%x; unmatched streams %s\n",
+		    PU_USB_SID, (scr0 & (1u << 10)) ? "fault (USFCFG=1)" : "bypass (USFCFG=0)");
+	}
+}
+
+/* ---------------------------------------------------------------------------
+ * 2. 三路电源。PMIC5 LDO（PM8150 = SID 0，LDOn 在 0x4000 + (n-1) * 0x100）：
+ *   TYPE 0x04、SUBTYPE 0x05、STATUS1 0x08（位 7 VREG_READY）、VSET_LB/UB 0x40/0x41（毫伏）、
+ *   EN_CTL 0x46（位 7）。由 RPMh 管，EN_CTL 不一定反映真实状态，VREG_READY 才是。
+ * L5A 同时给 UFS PHY（ufsphy_mem vdda-phy），UFS 能用它就一定开着。
+ * ------------------------------------------------------------------------- */
+static const struct {
+	const char *name;
+	unsigned    base;
+	const char *res;        /* cmd-db 资源名 */
+	unsigned    mv;         /* phy-msm-snps-hs.c 的最低电压 */
+} pu_rails[] = {
+	{ "L5A vdd", 0x4400, "ldoa5", 880 },
+	{ "L12A vdda18", 0x4b00, "ldoa12", 1800 },
+	{ "L2A vdda33", 0x4100, "ldoa2", 3050 },
+};
+#define PU_RAIL_SID     0u
+
+static void
+pu_rails_check(int vote)
+{
+	bool spmi = sweet_spmi_init() == 0;
+	for (unsigned i = 0; i < sizeof(pu_rails) / sizeof(pu_rails[0]); i++) {
+		uint8_t type = 0, sub = 0, st = 0, lb = 0, ub = 0, en = 0;
+		bool ok = spmi &&
+		    !sweet_spmi_read(PU_RAIL_SID, pu_rails[i].base + 0x04, &type) &&
+		    !sweet_spmi_read(PU_RAIL_SID, pu_rails[i].base + 0x05, &sub) &&
+		    !sweet_spmi_read(PU_RAIL_SID, pu_rails[i].base + 0x08, &st) &&
+		    !sweet_spmi_read(PU_RAIL_SID, pu_rails[i].base + 0x40, &lb) &&
+		    !sweet_spmi_read(PU_RAIL_SID, pu_rails[i].base + 0x41, &ub) &&
+		    !sweet_spmi_read(PU_RAIL_SID, pu_rails[i].base + 0x46, &en);
+		bool ready = ok && (st & 0x80u);
+		if (ok) {
+			printf("SWEET USB: rail %-11s (%s) type 0x%02x/0x%02x STATUS1 0x%02x (%s) VSET %u mV EN_CTL 0x%02x\n",
+			    pu_rails[i].name, pu_rails[i].res, type, sub, st, ready ? "ready" : "NOT ready",
+			    lb | (ub << 8), en);
+		} else {
+			printf("SWEET USB: rail %-11s (%s) not readable over SPMI\n", pu_rails[i].name, pu_rails[i].res);
+		}
+		/* 读不到状态时只有 sweetusbvreg=2 才投票 */
+		if (vote == 2 || (vote == 1 && ok && !ready)) {
+			int error = sweet_rpmh_vreg_enable(pu_rails[i].res, pu_rails[i].mv);
+			printf("SWEET USB: rail %s RPMh vote %u mV: %s (%d)\n", pu_rails[i].res, pu_rails[i].mv,
+			    error ? "failed" : "done", error);
+		}
+	}
+}
+
+/* ---------------------------------------------------------------------------
+ * 3. HS PHY
+ * ------------------------------------------------------------------------- */
+static vm_offset_t pu_phy;
+static unsigned pu_phy_errors;
+
+static uint32_t
+pu_phy_rd(uint32_t off)
+{
+	return pu_rd(pu_phy, off) & 0xffu;      /* 8 位寄存器，桥把字节重复了四次 */
+}
+
+/* msm_usb_write_readback()：只改 mask 里的位，再读回核对 */
+static void
+pu_phy_rmw(uint32_t off, uint32_t mask, uint32_t val)
+{
+	pu_wr(pu_phy, off, (pu_phy_rd(off) & ~mask) | val);
+	uint32_t got = pu_phy_rd(off) & mask;
+	if (got != val) {
+		pu_phy_errors++;
+		printf("SWEET USB: HSPHY write 0x%02x/0x%02x to 0x%02x read back 0x%02x\n", val, mask, off, got);
+	}
+}
+
+static void
+pu_phy_dump(const char *when)
+{
+	printf("SWEET USB: HSPHY %s UTMI0 %02x UTMI5 %02x COMMON0 %02x COMMON1 %02x COMMON2 %02x CTRL1 %02x CTRL2 %02x CFG0 %02x REFCLK %02x X0..X3 %02x %02x %02x %02x\n",
+	    when, pu_phy_rd(UTMI_CTRL0), pu_phy_rd(UTMI_CTRL5), pu_phy_rd(CTRL_COMMON0),
+	    pu_phy_rd(CTRL_COMMON1), pu_phy_rd(CTRL_COMMON2), pu_phy_rd(CTRL1), pu_phy_rd(CTRL2),
+	    pu_phy_rd(PHY_CFG0), pu_phy_rd(REFCLK_CTRL), pu_phy_rd(OVERRIDE_X0), pu_phy_rd(OVERRIDE_X1),
+	    pu_phy_rd(OVERRIDE_X2), pu_phy_rd(OVERRIDE_X3));
+}
+
+/* msm_hsphy_init() 走完之后各寄存器应有的样子 */
+static bool
+pu_phy_initialized(void)
+{
+	if (!(pu_phy_rd(UTMI_CTRL0) & SLEEPM) || (pu_phy_rd(UTMI_CTRL5) & POR) ||
+	    !(pu_phy_rd(CTRL2) & USB2_SUSPEND_N) || (pu_phy_rd(CTRL2) & USB2_SUSPEND_N_SEL) ||
+	    (pu_phy_rd(PHY_CFG0) & CMN_CTRL_OVERRIDE_EN) || (pu_phy_rd(CTRL_COMMON0) & FSEL_MASK) ||
+	    (pu_phy_rd(REFCLK_CTRL) & REFCLK_SEL_MASK) != REFCLK_SEL_DEFAULT ||
+	    !(pu_phy_rd(CTRL_COMMON2) & VREGBYPASS)) {
+		return false;
+	}
+	for (unsigned i = 0; i < sizeof(pu_override_seq) / sizeof(pu_override_seq[0]); i++) {
+		if (pu_phy_rd(pu_override_seq[i][1]) != pu_override_seq[i][0]) {
+			return false;
+		}
+	}
+	return true;
+}
+
+static void
+pu_phy_init(vm_offset_t gcc)
+{
+	/* msm_hsphy_reset()：复位 100-150 us */
+	pu_wr(gcc, PU_HSPHY_BCR, pu_rd(gcc, PU_HSPHY_BCR) | 1u);
+	delay(150);
+	pu_wr(gcc, PU_HSPHY_BCR, pu_rd(gcc, PU_HSPHY_BCR) & ~1u);
+	delay(10);
+	pu_phy_errors = 0;
+	/* msm_hsphy_init()，顺序与原厂驱动一致 */
+	pu_phy_rmw(PHY_CFG0, CMN_CTRL_OVERRIDE_EN, CMN_CTRL_OVERRIDE_EN);
+	pu_phy_rmw(UTMI_CTRL5, POR, POR);
+	pu_phy_rmw(CTRL_COMMON0, FSEL_MASK, 0);                 /* 19.2 MHz 参考时钟 */
+	pu_phy_rmw(CTRL_COMMON1, PLLBTUNE, PLLBTUNE);
+	pu_phy_rmw(REFCLK_CTRL, REFCLK_SEL_MASK, REFCLK_SEL_DEFAULT);
+	pu_phy_rmw(CTRL_COMMON1, VBUSVLDEXTSEL0, VBUSVLDEXTSEL0);
+	pu_phy_rmw(CTRL1, VBUSVLDEXT0, VBUSVLDEXT0);
+	for (unsigned i = 0; i < sizeof(pu_override_seq) / sizeof(pu_override_seq[0]); i++) {
+		/* hsusb_phy_write_seq()：整字节直接写 */
+		pu_wr(pu_phy, pu_override_seq[i][1], pu_override_seq[i][0]);
+		if (pu_phy_rd(pu_override_seq[i][1]) != pu_override_seq[i][0]) {
+			pu_phy_errors++;
+		}
+	}
+	pu_phy_rmw(CTRL_COMMON2, VREGBYPASS, VREGBYPASS);
+	pu_phy_rmw(CTRL2, USB2_SUSPEND_N_SEL | USB2_SUSPEND_N, USB2_SUSPEND_N_SEL | USB2_SUSPEND_N);
+	pu_phy_rmw(UTMI_CTRL0, SLEEPM, SLEEPM);
+	pu_phy_rmw(UTMI_CTRL5, POR, 0);
+	pu_phy_rmw(CTRL2, USB2_SUSPEND_N_SEL, 0);
+	pu_phy_rmw(PHY_CFG0, CMN_CTRL_OVERRIDE_EN, 0);
+	delay(1000);    /* 原厂驱动不等；给 PLL 锁定、UTMI 时钟出来留 1 ms */
+}
