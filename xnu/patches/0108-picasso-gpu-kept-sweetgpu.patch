+/*
+ * 挂起的 3D 核心，救回来（ios-apollo 0163，Linux a6xx_recover 去掉断电重来）：命令处理器停下、核心软复位
+ * （RBBM_SW_RESET_CMD）、清 SMMU 故障记录、重写第 16 步的寄存器、重启处理器、ring 开头 ME_INIT + 出安全模式，
+ * 之前的提交一律算做完（围栏字写成最后一次的编号）。一次开机最多 32 次；picassogpurecover=0 关掉。
+ */
+#define RBBM_SW_RESET_CMD       GPU_W(0x0043)
+bool
+sweet_gpu_recover(void)
+{
+	static uint32_t recoveries;
+	uint32_t enabled = 1, rptr = ~0u, status = ~0u, fsr;
+	(void)PE_parse_boot_argn("picassogpurecover", &enabled, sizeof(enabled));
+	if (!kept.on || !enabled) {
+		return false;
+	}
+	if (recoveries >= 32) {
+		printf(TAG ": kept: the core hung again; 32 recoveries this boot are the limit: it stays stopped\n");
+		return false;
+	}
+	recoveries++;
+	wr(gpu.base + CP_SQE_CNTL, 0);
+	wr(gpu.base + RBBM_SW_RESET_CMD, 1);
+	(void)rd(gpu.base + RBBM_SW_RESET_CMD);
+	sleep_us(100);
+	wr(gpu.base + RBBM_SW_RESET_CMD, 0);
+	sleep_us(100);
+	uint32_t cb = smmu_context(&core_space);
+	fsr = rd(smmu.base + cb + SMMU_CB_FSR);
+	if (fsr & SMMU_FSR_ALL) {
+		wr(smmu.base + cb + SMMU_CB_FSR, fsr);
+	}
+	core_hw_regs();
+	wr(gpu.base + CP_SQE_CNTL, 1);
+	sleep_ms(2);
+	ring_at = ring_sent = 0;
+	ring_command(CP_ME_INIT, 8);
+	ring(0x2f);
+	ring(0x3);
+	ring(0x20000000);
+	ring(0);
+	ring(0);
+	ring(0);
+	ring(0);
+	ring(0);
+	ring_command(CP_SET_SECURE_MODE, 1);
+	ring(0);
+	ring_send();
+	for (int i = 0; i < 20000 && (rd(gpu.base + CP_RB_RPTR) != ring_at || (rd(gpu.base + RBBM_STATUS) & ~1u)); i++) {
+		sleep_us(100);
+	}
+	rptr = rd(gpu.base + CP_RB_RPTR);
+	status = rd(gpu.base + RBBM_STATUS);
+	if (rptr != ring_at || (status & ~1u) || rd(gpu.base + CP_HW_FAULT) != 0) {
+		printf(TAG ": kept: recovery %u FAILED: rptr %u of %u, status %#x cp fault %#x smmu fsr was %#x: the core stays stopped\n",
+		    recoveries, rptr, ring_at, status, rd(gpu.base + CP_HW_FAULT), fsr);
+		return false;
+	}
+	*(volatile uint32_t *)(core_scratch.memory + KEPT_FENCE_AT) = kept.fence;
+	to_memory(core_scratch.memory + KEPT_FENCE_AT, 4);
+	printf(TAG ": kept: RECOVERED the hung core (recovery %u; smmu fsr was %#x); submissions up to %u count as done\n",
+	    recoveries, fsr, kept.fence);
+	return true;
+}
