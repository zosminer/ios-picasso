+static struct {
+	bool on;
+	uint32_t fence;                         /* 最后一次提交的编号 */
+	uint32_t khz;                           /* 向 GMU 要的速度 */
+} kept;
+static struct {
+	uint64_t start, size;
+} kept_free[KEPT_FREE_RUNS];                    /* 没在用的地址，从低到高 */
+static unsigned kept_free_count;
+
+bool
+sweet_gpu_ready(void)
+{
+	return kept.on;
+}
