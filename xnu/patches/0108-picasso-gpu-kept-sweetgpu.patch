+/*
+ * msm GET_PARAM（msm_drm.h 的号；Linux adreno_get_param 和 a6xx_calc_ubwc_config）。Adreno 620 的值：
+ * 芯片号 0x06020001（设备树 qcom,chipid）、GPU 号 620、GMEM 512 KiB（adreno-gpulist.h a620 gmem_size SZ_512K）、
+ * 最高 bank 位 14（设备树 qcom,highest-bank-bit = 0x0e）、a650 家族 GMEM_BASE 0。
+ * UBWC_SWIZZLE / MACROTILE_MODE：Linux a6xx_calc_ubwc_config 对 UBWC 3.0 取 swizzle 6、macrotile 1（和 apollo 同值）。
+ */
+bool
+sweet_gpu_parameter(uint32_t which, uint64_t *value)
+{
+	switch (which) {
+	case 0x01:                              /* GPU_ID */
+		*value = 620;
+		return true;
+	case 0x02:                              /* GMEM_SIZE */
+		*value = 0x80000;
+		return true;
+	case 0x03:                              /* CHIP_ID */
+		*value = 0x06020001;
+		return true;
+	case 0x04:                              /* MAX_FREQ */
+		*value = (uint64_t)kept.khz * 1000u;
+		return true;
+	case 0x05:                              /* TIMESTAMP：19.2 MHz 的计数器 */
+		*value = mach_absolute_time();
+		return true;
+	case 0x06:                              /* GMEM_BASE */
+	case 0x08:                              /* PP_PGTABLE */
+	case 0x09:                              /* FAULTS */
+	case 0x0a:                              /* SUSPENDS */
+	case 0x11:                              /* RAYTRACING */
+		*value = 0;
+		return true;
+	case 0x07:                              /* PRIORITIES：一个 ring */
+		*value = 1;
+		return true;
+	case 0x10:                              /* HIGHEST_BANK_BIT */
+		*value = 14;
+		return true;
+	case 0x12:                              /* UBWC_SWIZZLE */
+		*value = 6;
+		return true;
+	case 0x13:                              /* MACROTILE_MODE */
+		*value = 1;
+		return true;
+	default:                                /* VA_START / VA_SIZE 等：所有客户端共用一个空间，不回答 */
+		return false;
+	}
+}
+
+static uint64_t
+kept_span(uint64_t size)
+{
+	return (size + KEPT_VA_GRANULE - 1u) & ~(KEPT_VA_GRANULE - 1u);
+}
+
+/* 给一块缓冲区要地址，先到先得；0 = 没有了。活着的缓冲区不会被挪走。 */
+uint64_t
+sweet_gpu_address(uint64_t size)
+{
+	size = kept_span(size);
+	for (unsigned i = 0; i < kept_free_count; ++i) {
+		if (kept_free[i].size >= size) {
+			uint64_t address = kept_free[i].start;
+			kept_free[i].start += size;
+			kept_free[i].size -= size;
+			if (kept_free[i].size == 0) {
+				--kept_free_count;
+				for (unsigned k = i; k < kept_free_count; ++k) {
+					kept_free[k] = kept_free[k + 1];
+				}
+			}
+			return address;
+		}
+	}
+	return 0;
+}
+
+void
+sweet_gpu_address_free(uint64_t address, uint64_t size)
+{
+	unsigned at;
+	size = kept_span(size);
+	for (at = 0; at < kept_free_count && kept_free[at].start < address; ++at) {
+	}
+	if (at > 0 && kept_free[at - 1].start + kept_free[at - 1].size == address) {
+		kept_free[at - 1].size += size;
+		if (at < kept_free_count && address + size == kept_free[at].start) {
+			kept_free[at - 1].size += kept_free[at].size;
+			--kept_free_count;
+			for (unsigned k = at; k < kept_free_count; ++k) {
+				kept_free[k] = kept_free[k + 1];
+			}
+		}
+	} else if (at < kept_free_count && address + size == kept_free[at].start) {
+		kept_free[at].start = address;
+		kept_free[at].size += size;
+	} else if (kept_free_count < KEPT_FREE_RUNS) {
+		for (unsigned k = kept_free_count++; k > at; --k) {
+			kept_free[k] = kept_free[k - 1];
+		}
+		kept_free[at].start = address;
+		kept_free[at].size = size;
+	} else {
+		printf(TAG ": kept: no room to remember free addresses %#llx+%#llx: lost\n", (unsigned long long)address,
+		    (unsigned long long)size);
+	}
+}
