+/* 在把 GPU 交给程序之前：走服务同样的调用提交一个命令缓冲，往草稿页写一个字 */
+static bool
+kept_self_test(void)
+{
+	vm_offset_t ib = 0;
+	uint64_t va = sweet_gpu_address(4096);
+	volatile uint32_t *word = (volatile uint32_t *)(core_scratch.memory + 0x80u);
+	bool ok = false;
+	if (va == 0 || kmem_alloc(kernel_map, &ib, PAGE_SIZE, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) !=
+	    KERN_SUCCESS) {
+		printf(TAG ": kept: self-test: no address or memory\n");
+		return false;
+	}
+	if (!sweet_gpu_map(va, kvtophys(ib), false)) {
+		printf(TAG ": kept: self-test: cannot map %#llx\n", (unsigned long long)va);
+		return false;
+	}
+	sweet_gpu_mapped();
+	volatile uint32_t *cmd = (volatile uint32_t *)ib;
+	cmd[0] = 7u << 28 | 3u | odd_parity(3) << 15 | CP_MEM_WRITE << 16 | odd_parity(CP_MEM_WRITE) << 23;
+	cmd[1] = CORE_SCRATCH_ADDRESS + 0x80u;
+	cmd[2] = 0;
+	cmd[3] = 0x5eed600du;
+	to_memory(ib, 64);
+	uint64_t addresses[1] = { va };
+	uint32_t words[1] = { 4 };
+	uint32_t fence = sweet_gpu_submit(addresses, words, 1);
+	for (unsigned i = 0; fence != 0 && i < 10000 && !sweet_gpu_done(fence); ++i) {
+		sleep_us(100);
+	}
+	to_memory(core_scratch.memory + 0x80u, 4);
+	ok = fence != 0 && sweet_gpu_done(fence) && *word == 0x5eed600du;
+	printf(TAG ": kept: self-test: submission %u (indirect buffer at %#llx) %s, word %#x: %s\n", fence,
+	    (unsigned long long)va, fence != 0 && sweet_gpu_done(fence) ? "done" : "NOT DONE", *word,
+	    ok ? "SUBMISSIONS AND FENCES WORK" : "FAILED");
+	if (!ok) {
+		sweet_gpu_report("self-test");
+	}
+	sweet_gpu_unmap(va, 4096);
+	sweet_gpu_address_free(va, 4096);
+	return ok;
+}
