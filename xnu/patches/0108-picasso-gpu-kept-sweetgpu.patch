+/* 我们的一个 4K 页放到核心的一个地址上；一块缓冲区最后一页之后调 sweet_gpu_mapped() */
+bool
+sweet_gpu_map(uint64_t address, uint64_t phys, bool read_only)
+{
+	return space_map(&core_space, address, phys, PTE_CORE | (read_only ? PTE_READ_ONLY : 0));
+}
+
+/* 页表改过之后：每个表出缓存，TLB 忘掉旧的（不经过 put()：这是热路径，不打日志） */
+static void
+kept_refresh(void)
+{
+	uint32_t cb = smmu_context(&core_space);
+	for (uint32_t i = 0; i < core_space.table_count; i++) {
+		to_memory((vm_offset_t)core_space.tables[i].table, 4096);
+	}
+	wr(smmu.base + cb + SMMU_CB_TLBIASID, core_space.context);
+	wr(smmu.base + cb + SMMU_CB_TLBSYNC, 1);
+	for (int i = 0; i < 1000 && (rd(smmu.base + cb + SMMU_CB_TLBSTATUS) & 1u); i++) {
+		sleep_us(10);
+	}
+}
+
+void
+sweet_gpu_mapped(void)
+{
+	kept_refresh();
+}
+
+/* 一个 4K 页取消映射（表保留） */
+static void
+space_unmap(struct gpu_space *space, uint64_t address)
+{
+	if ((address >> 39) || space->root == NULL) {
+		return;
+	}
+	uint64_t e1 = space->root[address >> 30 & 0x1ff];
+	uint64_t *l2 = NULL, *l3 = NULL;
+	for (uint32_t i = 0; (e1 & 1) && i < space->table_count; i++) {
+		if (space->tables[i].phys == (e1 & PTE_ADDRESS)) {
+			l2 = space->tables[i].table;
+			break;
+		}
+	}
+	uint64_t e2 = l2 ? l2[address >> 21 & 0x1ff] : 0;
+	for (uint32_t i = 0; (e2 & 1) && i < space->table_count; i++) {
+		if (space->tables[i].phys == (e2 & PTE_ADDRESS)) {
+			l3 = space->tables[i].table;
+			break;
+		}
+	}
+	if (l3) {
+		l3[address >> 12 & 0x1ff] = 0;
+	}
+}
+
+void
+sweet_gpu_unmap(uint64_t address, uint64_t size)
+{
+	for (uint64_t o = 0; o < size; o += 4096u) {
+		space_unmap(&core_space, address + o);
+	}
+	kept_refresh();
+}
+
+/* 核心和程序共享的内存，出 CPU 缓存（NULL、0：只是个屏障） */
+void
+sweet_gpu_to_memory(void *start, uint64_t size)
+{
+	if (start != NULL && size != 0) {
+		to_memory((vm_offset_t)start, size);
+	} else {
+		settle();
+	}
+}
+
+bool
+sweet_gpu_done(uint32_t fence)
+{
+	volatile uint32_t *word = (volatile uint32_t *)(core_scratch.memory + KEPT_FENCE_AT);
+	to_memory((vm_offset_t)word, 4);
+	return (int32_t)(*word - fence) >= 0;
+}
+
+uint32_t
+sweet_gpu_last(void)
+{
+	return kept.fence;
+}
+
+/*
+ * 按 Linux a6xx_submit 的样子把命令缓冲放进 ring：CCU 失效、每个命令缓冲一个间接缓冲、围栏写进
+ * 一个暂存寄存器，再用 CACHE_FLUSH_TS 写进内存。返回这次提交的编号；0 = ring 一直是满的（核心没在读）。
+ */
+uint32_t
+sweet_gpu_submit(const uint64_t *addresses, const uint32_t *words, uint32_t count)
+{
+	uint32_t wanted = 16u + 4u * count, room = 0;
+	for (unsigned i = 0; i < 20000; ++i) {
+		room = (rd(gpu.base + CP_RB_RPTR) + RING_WORDS - ring_at - 1u) % RING_WORDS;
+		if (room >= wanted) {
+			break;
+		}
+		sleep_us(100);
+	}
+	if (room < wanted) {
+		return 0;
+	}
+	if (++kept.fence == 0) {
+		kept.fence = 1;
+	}
+	ring_command(CP_EVENT_WRITE, 1);
+	ring(EVENT_CCU_INVALIDATE_DEPTH);
+	ring_command(CP_EVENT_WRITE, 1);
+	ring(EVENT_CCU_INVALIDATE_COLOR);
+	for (uint32_t i = 0; i < count; ++i) {
+		ring_command(CP_INDIRECT_BUFFER, 3);
+		ring((uint32_t)addresses[i]);
+		ring((uint32_t)(addresses[i] >> 32));
+		ring(words[i]);
+	}
+	ring_register(GPU_CP_SCRATCH_REG2, kept.fence);
+	ring_command(CP_EVENT_WRITE, 4);
+	ring(EVENT_CACHE_FLUSH_TS);
+	ring(CORE_SCRATCH_ADDRESS + KEPT_FENCE_AT);
+	ring(0);
+	ring(kept.fence);
+	ring_send();
+	return kept.fence;
+}
+
+/* 一次提交不回来：核心和它的 SMMU 上下文怎么说 */
+void
+sweet_gpu_report(const char *why)
+{
+	printf(TAG ": kept: %s: submission %u is the last, the core has done %u; ring read %u written %u; status %#x "
+	    "int %#x cp fault %#x cp int %#x protect %#x\n", why, kept.fence,
+	    *(volatile uint32_t *)(core_scratch.memory + KEPT_FENCE_AT), rd(gpu.base + CP_RB_RPTR), ring_at,
+	    rd(gpu.base + RBBM_STATUS), rd(gpu.base + RBBM_INT_0_STATUS), rd(gpu.base + CP_HW_FAULT),
+	    rd(gpu.base + CP_INTERRUPT_STATUS), rd(gpu.base + CP_PROTECT_STATUS));
+	(void)space_faulted(&core_space);
+}
