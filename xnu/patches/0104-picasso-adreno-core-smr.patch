+/* 一条流表项：SMR 读回不对就清掉这一项（hypervisor 不接受的写读回是 0），返回 false */
+static bool
+space_stream_try(struct gpu_space *space, uint32_t match, uint32_t stream, uint32_t mask)
+{
+	uint32_t want = SMMU_SMR_VALID | mask << 16 | stream;
+	put(&smmu, "s2cr", SMMU_S2CR(match), space->context);
+	put(&smmu, "smr", SMMU_SMR(match), want);
+	if (get(&smmu, "smr", SMMU_SMR(match)) == want && (get(&smmu, "s2cr", SMMU_S2CR(match)) & 0x300ff) == space->context) {
+		return true;
+	}
+	put(&smmu, "smr", SMMU_SMR(match), 0);
+	put(&smmu, "s2cr", SMMU_S2CR(match), SMMU_S2CR_FAULT);
+	return false;
+}
