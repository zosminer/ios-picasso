 {
 	SweetBattery *self = OSDynamicCast(SweetBattery, owner);
 	if (self && self->fRunning) {
-		self->poll();
-		sender->setTimeoutMS(30000);
+		/* picasso：8 s 一次喂充电器看门狗（bark 16 s），电量照旧约 30 s 读一次 */
+		self->chargerKeep();
+		if (++self->fTick % 4 == 0) {
+			self->poll();
+		}
+		sender->setTimeoutMS(8000);
 	}
 }
 
