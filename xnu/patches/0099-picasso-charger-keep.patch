+/*
+ * picasso（logs/boot-k7.txt，2026-10-31 夜）：插着电脑 USB，整夜 external=1 charging=0、电流 -515 mA 起，
+ * 电池放到 3004 mV 关机。OrangeFox（Linux qpnp-smb5）下同一根线 Charging，-752 mA。
+ * Linux smb5_init_hw 把充电器看门狗配成"插入时启动、bark 16 s（dt qcom,wd-bark-time-secs）、
+ * 再 8 s bite、bite 时停止充电"（SNARL_BARK_BITE_WD_CFG 位 7 BITE_WDOG_DISABLE_CHARGING_CFG），
+ * 只在 bark 中断里喂狗。从 Linux 重启进我们的内核后没人喂狗 → 推测就是这个停了充电（待本函数的日志证实）。
+ * picassocharge=1（默认）：每 8 s 喂一次狗（写 MISC 0x1643 = 1，同 Linux wdog_bark_irq_handler）；
+ *   充电命令位（CHGR 0x1042 位 0）被清了就置回 1，USB 输入挂起位（USBIN 0x1340 位 0）被置了就清掉
+ *   （Linux 不挂起、不禁止充电时也是这两个值）。电流、电压、温度保护全部保持原样，由充电器硬件管。
+ * picassocharge=0：只记录不写。
+ * 寄存器变化时打一行（最多 60 行）：寄存器名和偏移照 smb5-reg.h。
+ */
+static const struct {
+	uint16_t addr;
+	const char *name;
+} kChgRegs[] = {
+	{ 0x1006, "chg_st1" }, { 0x1007, "chg_st2" }, { 0x100b, "chg_st5" }, { 0x100d, "chg_st7" },
+	{ 0x1042, "chg_en_cmd" }, { 0x1043, "pause_cmd" }, { 0x1051, "chgr_cfg2" },
+	{ 0x1061, "fcc_cfg" }, { 0x1070, "fv_cfg" },
+	{ 0x1107, "icl_st" }, { 0x1108, "aicl_icl_st" }, { 0x110b, "pwr_path" },
+	{ 0x1307, "apsd_st" }, { 0x1308, "apsd_result" }, { 0x1340, "usbin_suspend" },
+	{ 0x1366, "icl_opts" }, { 0x1370, "icl_cfg" },
+	{ 0x1606, "temp_range" }, { 0x1651, "wd_cfg" }, { 0x1653, "wd_bark_bite" },
+};
+
+void
+SweetBattery::chargerKeep(void)
+{
+	uint8_t now[sizeof(kChgRegs) / sizeof(kChgRegs[0])];
+	bool ok = true;
+	for (unsigned i = 0; i < sizeof(now); ++i) {
+		if (sweet_spmi_read(2, kChgRegs[i].addr, &now[i])) {
+			now[i] = 0xff;
+			ok = false;
+		}
+	}
+	if ((!fChgLogged || memcmp(now, fChgLast, sizeof(now))) && fChgLines < 60) {
+		char line[512];
+		int n = snprintf(line, sizeof(line), "SWEET CHARGER:%s", ok ? "" : " (some reads failed)");
+		for (unsigned i = 0; i < sizeof(now) && n > 0 && (unsigned)n < sizeof(line); ++i) {
+			n += snprintf(line + n, sizeof(line) - (unsigned)n, " %s=%02x", kChgRegs[i].name, now[i]);
+		}
+		IOLog("%s\n", line);
+		memcpy(fChgLast, now, sizeof(now));
+		fChgLogged = true;
+		++fChgLines;
+	}
+	if (fCharge < 1 || !ok) {
+		return;
+	}
+	static const uint8_t one = 1;
+	int err = sweet_spmi_write(2, 0x1643, &one, 1);         /* BARK_BITE_WDOG_PET */
+	if (err && fChgLines < 60) {
+		IOLog("SWEET CHARGER: watchdog pet refused\n");
+		++fChgLines;
+	}
+	if (!(now[4] & 1u)) {                                   /* CHARGING_ENABLE_CMD 位 0 */
+		uint8_t v = (uint8_t)(now[4] | 1u);
+		err = sweet_spmi_write(2, 0x1042, &v, 1);
+		IOLog("SWEET CHARGER: charging enable command was off; set (%d)\n", err);
+	}
+	if (now[14] & 1u) {                                     /* USBIN_CMD_IL 位 0 = 输入挂起 */
+		uint8_t v = (uint8_t)(now[14] & ~1u);
+		err = sweet_spmi_write(2, 0x1340, &v, 1);
+		IOLog("SWEET CHARGER: USB input was suspended; resumed (%d)\n", err);
+	}
+}
