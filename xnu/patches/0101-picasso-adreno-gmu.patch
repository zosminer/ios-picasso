+/* ---------------------------------------------------------------- 1. CX 和 GMU 时钟 */
+
+static bool
+cx_is_on(void)
+{
+	return (rd(gpucc.base + CC_CX_GDSCR) | rd(gpucc.base + CC_CX_HW_CTRL)) & GDSC_POWER_ON;
+}
+
+static bool
+clock_on(struct block *b, const char *name, uint32_t cbcr, bool must)
+{
+	if (!(set(b, name, cbcr, CBCR_ENABLE) & CBCR_OFF) || wait_for(b, cbcr, CBCR_OFF, 0, 10)) {
+		return true;
+	}
+	printf(TAG ": %u: %s %s stays off (%#x)%s\n", step, b->name, name, rd(b->base + cbcr),
+	    must ? "" : " (a voted clock: going on)");
+	return !must;
+}
