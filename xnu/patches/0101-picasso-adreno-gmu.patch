+#define TAG "PICASSO ADRENO"
+
+static uint32_t step, newest_step, pause_ms = 1200;
+static bool quiet;
+static char last_write[96] = "nothing written";
+
+static void
+sleep_us(uint32_t us)
+{
+	delay_for_interval(us, NSEC_PER_USEC);
+}
+
+static void
+sleep_ms(uint32_t ms)
+{
+	delay_for_interval(ms, NSEC_PER_MSEC);
+}
+
+/* 一次访问就是一条普通的 ldr/str（SMMU 的全局寄存器由 hypervisor 模拟，只认最简单的指令形式） */
+static uint32_t __attribute__((noinline))
+rd(vm_offset_t address)
+{
+	uint32_t value;
+	__asm__ volatile ("ldr %w0, [%1]" : "=r" (value) : "r" (address) : "memory");
+	return value;
+}
+
+static void __attribute__((noinline))
+wr(vm_offset_t address, uint32_t value)
+{
+	__asm__ volatile ("str %w0, [%1]" : : "r" (value), "r" (address) : "memory");
+}
+
+static void
+settle(void)
+{
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/* CPU 写过的内存刷出缓存：GPU 这边读的是内存 */
+static void
+to_memory(vm_offset_t start, vm_size_t size)
+{
+	for (vm_offset_t line = start & ~(vm_offset_t)63; line < start + size; line += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (line) : "memory");
+	}
+	settle();
+}
+
+struct block {
+	const char *name;
+	uint32_t phys, size;
+	vm_offset_t base;
+};
+
+static void
+need(struct block *b)
+{
+	if (b->base == 0) {
+		b->base = ml_io_map(b->phys, b->size);
+	}
+}
+
+static void
+hold(bool single)
+{
+	if (step == newest_step && pause_ms && !single) {
+		sleep_ms(pause_ms);
+	}
+}
+
+static void
+announce(const char *what)
+{
+	printf(TAG ": step %u: %s\n", step, what);
+	hold(false);
+}
+
+static uint32_t
+get(struct block *b, const char *name, uint32_t off)
+{
+	need(b);
+	uint32_t v = rd(b->base + off);
+	if (!quiet) {
+		printf(TAG ": %u: %s %s (%#x) = %#x\n", step, b->name, name, b->phys + off, v);
+	}
+	return v;
+}
+
+static void
+put(struct block *b, const char *name, uint32_t off, uint32_t v)
+{
+	need(b);
+	if (!quiet) {
+		printf(TAG ": %u: write %s %s (%#x) = %#x\n", step, b->name, name, b->phys + off, v);
+		snprintf(last_write, sizeof(last_write), "step %u wrote %#x to %s %s", step, v, b->name, name);
+	}
+	wr(b->base + off, v);
+}
+
+static uint32_t
+set(struct block *b, const char *name, uint32_t off, uint32_t bits)
+{
+	uint32_t was = get(b, name, off);
+	if ((was & bits) == bits) {
+		return was;
+	}
+	put(b, name, off, was | bits);
+	return get(b, name, off);
+}
+
+static bool
+wait_for(struct block *b, uint32_t off, uint32_t mask, uint32_t value, uint32_t ms)
+{
+	for (uint32_t i = 0; i < ms * 10; i++) {
+		if ((rd(b->base + off) & mask) == value) {
+			return true;
+		}
+		sleep_us(100);
+	}
+	return (rd(b->base + off) & mask) == value;
+}
