+static bool cx_powered_here;
+
+static bool
+step_cx(void)
+{
+	need(&gcc);
+	need(&gpucc);
+	if (rd(gcc.base + GCC_GPU_CFG_AHB) & CBCR_OFF) {
+		printf(TAG ": %u: gcc gpu_cfg_ahb is off: the GPU clock controller would not answer\n", step);
+		return false;
+	}
+	announce("the CX half on (gpu_cx_gdsc), and the GMU's clocks (0091 stage 2, seen working on k7)");
+	get(&gpucc, "cx_gdscr", CC_CX_GDSCR);
+	get(&gpucc, "gx_gdscr", CC_GX_GDSCR);
+	if (rd(gpucc.base + CC_GX_GDSCR) & GDSC_POWER_ON) {
+		printf(TAG ": %u: THE 3D CORE HAS POWER ALREADY (left by an earlier kernel): not touching it\n", step);
+		return false;
+	}
+	set(&gcc, "pll votes", GCC_PLL_VOTE, 3u << 15);
+	(void)clock_on(&gcc, "ddrss_gpu_axi", GCC_DDRSS_GPU_AXI, false);
+	(void)clock_on(&gcc, "gpu_memnoc_gfx", GCC_GPU_MEMNOC_GFX, false);
+	(void)clock_on(&gcc, "gpu_snoc_dvm_gfx", GCC_GPU_SNOC_DVM_GFX, false);
+	if (!cx_is_on()) {
+		uint32_t gdscr = get(&gpucc, "cx_gdscr", CC_CX_GDSCR);
+		if (gdscr & GDSC_HW_CONTROL) {
+			printf(TAG ": %u: the CX switch is under hardware control\n", step);
+			return false;
+		}
+		put(&gpucc, "cx_gdscr", CC_CX_GDSCR, gdscr & ~GDSC_SW_COLLAPSE);
+		cx_powered_here = true;
+		for (int i = 0; i < 500 && !cx_is_on(); i++) {
+			sleep_us(100);
+		}
+		get(&gpucc, "cx_gdscr", CC_CX_GDSCR);
+		get(&gpucc, "cx_hw_ctrl", CC_CX_HW_CTRL);
+		if (!cx_is_on()) {
+			printf(TAG ": %u: CX does not come on\n", step);
+			return false;
+		}
+	}
+	if (!clock_on(&gpucc, "cxo", CC_CXO, true) || !clock_on(&gpucc, "ahb", CC_AHB, true)) {
+		return false;
+	}
+	if ((get(&gpucc, "gmu_clk_src cfg", CC_GMU_RCG + 4) & 0x71f) != RCG_GMU_200MHZ) {
+		put(&gpucc, "gmu_clk_src cfg", CC_GMU_RCG + 4, RCG_GMU_200MHZ);
+		put(&gpucc, "gmu_clk_src cmd", CC_GMU_RCG, rd(gpucc.base + CC_GMU_RCG) | RCG_UPDATE);
+		if (!wait_for(&gpucc, CC_GMU_RCG, RCG_UPDATE, 0, 10)) {
+			printf(TAG ": %u: gmu_clk_src does not take 200 MHz\n", step);
+			return false;
+		}
+	}
+	uint32_t cx_gmu = get(&gpucc, "cx_gmu", CC_CX_GMU);
+	if ((cx_gmu & 0xff0) != 0xff0) {
+		put(&gpucc, "cx_gmu (wakeup/sleep 0xf)", CC_CX_GMU, cx_gmu | 0xff0);
+	}
+	if (!clock_on(&gpucc, "cx_gmu", CC_CX_GMU, true)) {
+		return false;
+	}
+	(void)clock_on(&gpucc, "smmu vote", CC_SMMU_VOTE, false);
+	printf(TAG ": %u: CX is on, the GMU has its clock\n", step);
+	return true;
+}
+
+/* 后面每一步都要：CX 有电、GMU 有时钟 */
+static bool
+cx_ready(void)
+{
+	need(&gpucc);
+	if (!cx_is_on() || (rd(gpucc.base + CC_CX_GMU) & (CBCR_ENABLE | CBCR_OFF)) != CBCR_ENABLE) {
+		printf(TAG ": %u: needs CX on and the GMU's clock running (step 1)\n", step);
+		return false;
+	}
+	return true;
+}
+
+/* ---------------------------------------------------------------- 2. 第一批读 */
+
+static bool
+step_words(void)
+{
+	if (!cx_ready()) {
+		return false;
+	}
+	announce("read the GMU's registers and its always-on counter; the GPU bus interface (GBIF)");
+	get(&gmu, "cm3_sysreset", GMU_CM3_SYSRESET);
+	get(&gmu, "cm3_boot_config", GMU_CM3_BOOT_CONFIG);
+	get(&gmu, "cm3_fw_init_result", GMU_CM3_FW_INIT_RESULT);
+	get(&gmu, "cm3_cfg", GMU_CM3_CFG);
+	get(&gmu, "hfi_ctrl_status", GMU_HFI_CTRL_STATUS);
+	get(&gmu, "general_7", GMU_GENERAL_7);
+	get(&gmu, "rpmh_power_state", GMU_RPMH_POWER_STATE);
+	get(&gmu, "sptprac_pwr_clk_status", GMU_SPTPRAC_PWR_CLK_STATUS);
+	get(&gmu, "ao_host_interrupt_status", GMU_AO_HOST_INTR_STATUS);
+	get(&gmu, "ao_gpu_cx_busy", GMU_AO_GPU_CX_BUSY);
+	get(&gmu, "ahb_fence_status", GMU_AHB_FENCE_STATUS);
+	uint64_t t0 = mach_absolute_time(), ns = 0;
+	uint32_t c0 = rd(gmu.base + GMU_AO_COUNTER_L);
+	sleep_ms(10);
+	uint32_t ticks = rd(gmu.base + GMU_AO_COUNTER_L) - c0;
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	uint32_t hz = ns ? (uint32_t)((uint64_t)ticks * NSEC_PER_SEC / ns) : 0;
+	printf(TAG ": %u: the GMU's counter runs at %u Hz%s\n", step, hz,
+	    hz > 18000000 && hz < 20500000 ? ": the 19.2 MHz crystal, THE GPU BLOCK ANSWERS" : "");
+	get(&gbif, "halt", GBIF_HALT);
+	get(&gbif, "halt_ack", GBIF_HALT_ACK);
+	return true;
+}
+
+/* ---------------------------------------------------------------- 3. RSCC */
+
+static void
+rscc_show(void)
+{
+	get(&rscc, "rsc_status0", RSCC_RSC_STATUS0);
+	get(&rscc, "seq_busy", RSCC_SEQ_BUSY);
+	get(&rscc, "seq_mem_0", RSCC_SEQ_MEM_0);
+	get(&rscc, "pdc_slave_id", RSCC_PDC_SLAVE_ID);
+	for (unsigned i = 0; i < 4; i++) {
+		get(&rscc, "tcs status", RSCC_TCS_STATUS(i));
+	}
+	get(&gmu, "rscc_control_ack", GMU_RSCC_CONTROL_ACK);
+}
+
+static bool
+step_rscc(void)
+{
+	if (!cx_ready()) {
+		return false;
+	}
+	announce("read the GMU's RPMh channel (rscc 0x3de0000)");
+	rscc_show();
+	return true;
+}
+
+/* ---------------------------------------------------------------- 4. SMMU */
+
+static uint32_t smmu_page, smmu_pages, smmu_contexts, smmu_matches;
+
+static bool
+smmu_layout(void)
+{
+	bool was = quiet;
+	quiet = true;
+	uint32_t idr0 = get(&smmu, "idr0", SMMU_IDR0), idr1 = get(&smmu, "idr1", SMMU_IDR1);
+	quiet = was;
+	smmu_page = idr1 >> 31 ? 0x10000 : 0x1000;
+	smmu_pages = 2u << (idr1 >> 28 & 7);
+	smmu_contexts = idr1 & 0xff;
+	smmu_matches = idr0 & 0xff;
+	if (2 * smmu_pages * smmu_page != smmu.size) {
+		printf(TAG ": %u: SMMU idr0 %#x idr1 %#x: %u pages of %#x do not make the device tree's %#x\n", step,
+		    idr0, idr1, smmu_pages, smmu_page, smmu.size);
+		return false;
+	}
+	return true;
+}
+
+static bool
+step_smmu(void)
+{
+	if (!cx_ready()) {
+		return false;
+	}
+	announce("read the GPU SMMU's ID registers, stream table and context kinds (kgsl-smmu 0x3da0000)");
+	get(&smmu, "idr0", SMMU_IDR0);
+	get(&smmu, "idr1", SMMU_IDR1);
+	get(&smmu, "idr2", SMMU_IDR2);
+	get(&smmu, "scr0", SMMU_SCR0);
+	get(&smmu, "sgfsr", SMMU_SGFSR);
+	if (!smmu_layout()) {
+		return false;
+	}
+	printf(TAG ": %u: SMMU: %u stream matches, %u contexts, %u pages of %#x\n", step, smmu_matches, smmu_contexts,
+	    smmu_pages, smmu_page);
+	for (uint32_t i = 0; i < smmu_matches && i < 8; i++) {
+		get(&smmu, "smr", SMMU_SMR(i));
+		get(&smmu, "s2cr", SMMU_S2CR(i));
+	}
+	for (uint32_t i = 0; i < smmu_contexts && i < 8; i++) {
+		get(&smmu, "cbar", smmu_page + SMMU_CBAR(i));
+	}
+	uint32_t cb = smmu_pages * smmu_page;
+	get(&smmu, "cb0 sctlr", cb + SMMU_CB_SCTLR);
+	get(&smmu, "cb1 sctlr", cb + smmu_page + SMMU_CB_SCTLR);
+	return true;
+}
+
+/* ---------------------------------------------------------------- 5. GMU 的 TCM */
+
+static bool
+step_tcm(void)
+{
+	static const uint32_t pattern[2] = { 0x600d0001, 0x0a110002 };
+	uint32_t was[2], back[2];
+	if (!cx_ready()) {
+		return false;
+	}
+	announce("hold the GMU's CM3 in reset, write two words into its DTCM (0x3d71000), read them back");
+	if (get(&gmu, "cm3_fw_init_result", GMU_CM3_FW_INIT_RESULT) == 0xbabeface) {
+		printf(TAG ": %u: firmware runs in the GMU: leaving it alone\n", step);
+		return false;
+	}
+	put(&gmu, "cm3_sysreset", GMU_CM3_SYSRESET, 1);
+	for (int i = 0; i < 2; i++) {
+		was[i] = get(&gmu, "dtcm", GMU_DTCM + 4 * i);
+		put(&gmu, "dtcm", GMU_DTCM + 4 * i, pattern[i]);
+	}
+	for (int i = 0; i < 2; i++) {
+		back[i] = get(&gmu, "dtcm", GMU_DTCM + 4 * i);
+		put(&gmu, "dtcm", GMU_DTCM + 4 * i, was[i]);
+	}
+	bool ok = back[0] == pattern[0] && back[1] == pattern[1];
+	printf(TAG ": %u: the GMU's DTCM %s\n", step, ok ? "TAKES WHAT IS WRITTEN" : "does not hold what was written");
+	return ok;
+}
+
+/* ---------------------------------------------------------------- 6. cmd-db */
+
+static bool
+step_cmd_db(void)
+{
+	announce("read RPMh's resource list (cmd-db, reserved memory 0x80860000)");
+	if (rpmh_resource("cx.lvl", NULL, NULL) == 0) {
+		printf(TAG ": %u: no cmd-db at %#x, or no cx.lvl in it\n", step, CMD_DB_PHYS);
+		return false;
+	}
+	show_rpmh_resource("gfx.lvl");
+	show_rpmh_resource("cx.lvl");
+	show_rpmh_resource("mx.lvl");
+	show_rpmh_resource("xo.lvl");
+	show_rpmh_resource("vrm.soc");
+	show_rpmh_resource("SH0");
+	show_rpmh_resource("MC0");
+	show_rpmh_resource("ACV");
+	show_rpmh_resource("CN0");
+	return true;
+}
+
+/* ---------------------------------------------------------------- GPU 这边看到的内存（SMMU 页表） */
+
+#define PTE_TABLE               3ull
+#define PTE_PAGE                3ull
+#define PTE_ADDRESS             0x0000fffffffff000ull
+#define PTE_GMU                 (2ull << 8 | 1ull << 10 | 1ull << 11)   /* 共享、AF、nG；属性 0 = 不缓存 */
+#define SPACE_TABLES            64
+
+struct gpu_space {
+	const char *name;
+	uint32_t context;
+	uint32_t table_count;
+	uint64_t *root;
+	struct {
+		uint64_t phys;
+		uint64_t *table;
+	} tables[SPACE_TABLES];
+};
+
+static uint64_t *
+space_new_table(struct gpu_space *space)
+{
+	static vm_offset_t spare;
+	static unsigned spare_left;
+	if (space->table_count == SPACE_TABLES) {
+		return NULL;
+	}
+	if (spare_left == 0) {
+		if (kmem_alloc(kernel_map, &spare, PAGE_SIZE, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) !=
+		    KERN_SUCCESS) {
+			return NULL;
+		}
+		spare_left = PAGE_SIZE / 4096;
+	}
+	uint64_t *table = (uint64_t *)(spare + PAGE_SIZE - 4096 * spare_left--);
+	space->tables[space->table_count].phys = kvtophys((vm_offset_t)table);
+	space->tables[space->table_count++].table = table;
+	return table;
+}
+
+static uint64_t *
+space_next(struct gpu_space *space, uint64_t *entry)
+{
+	if (*entry & 1) {
+		for (uint32_t i = 0; i < space->table_count; i++) {
+			if (space->tables[i].phys == (*entry & PTE_ADDRESS)) {
+				return space->tables[i].table;
+			}
+		}
+		return NULL;
+	}
+	uint64_t *table = space_new_table(space);
+	if (table) {
+		*entry = kvtophys((vm_offset_t)table) | PTE_TABLE;
+	}
+	return table;
+}
+
+static bool
+space_map(struct gpu_space *space, uint64_t address, uint64_t phys, uint64_t attributes)
+{
+	if (address >> 39 || (space->root == NULL && (space->root = space_new_table(space)) == NULL)) {
+		return false;
+	}
+	uint64_t *l2 = space_next(space, &space->root[address >> 30 & 0x1ff]);
+	uint64_t *l3 = l2 ? space_next(space, &l2[address >> 21 & 0x1ff]) : NULL;
+	if (l3 == NULL) {
+		return false;
+	}
+	l3[address >> 12 & 0x1ff] = phys | attributes | PTE_PAGE;
+	return true;
+}
+
+struct gpu_block {
+	uint64_t address;
+	uint32_t size;
+	vm_offset_t memory;
+};
+
+static bool
+block_new(struct gpu_space *space, struct gpu_block *block, uint64_t address, uint32_t size)
+{
+	block->address = address;
+	block->size = (size + 4095) & ~4095u;
+	if (kmem_alloc(kernel_map, &block->memory, round_page(block->size), KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+	    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return false;
+	}
+	for (uint32_t off = 0; off < block->size; off += 4096) {
+		if (!space_map(space, address + off, kvtophys(block->memory + off), PTE_GMU)) {
+			return false;
+		}
+	}
+	to_memory(block->memory, block->size);
+	printf(TAG ": %u: %s sees %#llx..%#llx in our memory at %#llx\n", step, space->name, address,
+	    address + block->size - 1, kvtophys(block->memory));
+	return true;
+}
+
+/* 同一块内存不经过 CPU 缓存的第二个映射（双方一个字一个字写的 HFI 页）；只适合物理连续的一页 */
+static vm_offset_t
+block_uncached(const struct gpu_block *block)
+{
+	uint64_t phys = kvtophys(block->memory);
+	for (uint32_t off = 0; off < block->size; off += 4096) {
+		if (kvtophys(block->memory + off) != phys + off) {
+			return 0;
+		}
+	}
+	return ml_io_map_wcomb((vm_offset_t)phys, block->size);
+}
+
+static uint32_t
+smmu_context(const struct gpu_space *space)
+{
+	return (smmu_pages + space->context) * smmu_page;
+}
+
+static bool
+space_faulted(const struct gpu_space *space)
+{
+	uint32_t cb = smmu_context(space), status = rd(smmu.base + cb + SMMU_CB_FSR);
+	if ((status & SMMU_FSR_ALL) == 0) {
+		return false;
+	}
+	printf(TAG ": %u: THE SMMU REFUSED %s: fsr %#x, address %#llx, syndrome %#x\n", step, space->name, status,
+	    (uint64_t)rd(smmu.base + cb + SMMU_CB_FAR + 4) << 32 | rd(smmu.base + cb + SMMU_CB_FAR),
+	    rd(smmu.base + cb + SMMU_CB_FSYNR0));
+	return true;
+}
+
+static bool
+space_on(struct gpu_space *space, uint32_t match, uint32_t stream)
+{
+	uint32_t cb = smmu_context(space);
+	uint64_t root = space->tables[0].phys | (uint64_t)space->context << 48;
+	for (uint32_t i = 0; i < space->table_count; i++) {
+		to_memory((vm_offset_t)space->tables[i].table, 4096);
+	}
+	put(&smmu, "cb sctlr", cb + SMMU_CB_SCTLR, 0);
+	put(&smmu, "cba2r", smmu_page + SMMU_CBA2R(space->context), 1);
+	put(&smmu, "cbar", smmu_page + SMMU_CBAR(space->context), SMMU_CBAR_STAGE_1);
+	put(&smmu, "cb tcr2", cb + SMMU_CB_TCR2, SMMU_TCR2);
+	put(&smmu, "cb tcr", cb + SMMU_CB_TCR, SMMU_TCR_39_BITS);
+	put(&smmu, "cb ttbr0 lo", cb + SMMU_CB_TTBR0, (uint32_t)root);
+	put(&smmu, "cb ttbr0 hi", cb + SMMU_CB_TTBR0 + 4, (uint32_t)(root >> 32));
+	put(&smmu, "cb ttbr1 lo", cb + SMMU_CB_TTBR1, 0);
+	put(&smmu, "cb ttbr1 hi", cb + SMMU_CB_TTBR1 + 4, 0);
+	put(&smmu, "cb mair0", cb + SMMU_CB_MAIR0, SMMU_MAIR0);
+	put(&smmu, "cb mair1", cb + SMMU_CB_MAIR1, 0);
+	put(&smmu, "cb fsr", cb + SMMU_CB_FSR, SMMU_FSR_ALL);
+	put(&smmu, "cb tlbiasid", cb + SMMU_CB_TLBIASID, space->context);
+	put(&smmu, "cb tlbsync", cb + SMMU_CB_TLBSYNC, 1);
+	if (!wait_for(&smmu, cb + SMMU_CB_TLBSTATUS, 1, 0, 100)) {
+		printf(TAG ": %u: the SMMU does not finish the TLB sync (%#x)\n", step, rd(smmu.base + cb + SMMU_CB_TLBSTATUS));
+		return false;
+	}
+	put(&smmu, "cb sctlr", cb + SMMU_CB_SCTLR, SMMU_SCTLR_ON);
+	put(&smmu, "s2cr", SMMU_S2CR(match), space->context);
+	put(&smmu, "smr", SMMU_SMR(match), SMMU_SMR_VALID | SMMU_STREAM_MASK << 16 | stream);
+	if (get(&smmu, "smr", SMMU_SMR(match)) != (SMMU_SMR_VALID | SMMU_STREAM_MASK << 16 | stream) ||
+	    (get(&smmu, "s2cr", SMMU_S2CR(match)) & 0x300ff) != space->context ||
+	    (get(&smmu, "cbar", smmu_page + SMMU_CBAR(space->context)) & 0x30000) != (SMMU_CBAR_STAGE_1 & 0x30000) ||
+	    !(get(&smmu, "cb sctlr", cb + SMMU_CB_SCTLR) & 1) ||
+	    get(&smmu, "cb ttbr0 lo", cb + SMMU_CB_TTBR0) != (uint32_t)root) {
+		printf(TAG ": %u: the SMMU did not take what was written: stream %u is not going through context %u\n", step,
+		    stream, space->context);
+		return false;
+	}
+	get(&smmu, "cb fsr", cb + SMMU_CB_FSR);
+	get(&smmu, "sgfsr", SMMU_SGFSR);
+	return true;
+}
+
+static void
+space_off(struct gpu_space *space, uint32_t match)
+{
+	put(&smmu, "smr", SMMU_SMR(match), 0);
+	put(&smmu, "s2cr", SMMU_S2CR(match), SMMU_S2CR_FAULT);
+	put(&smmu, "cb sctlr", smmu_context(space) + SMMU_CB_SCTLR, 0);
+}
+
+/* ---------------------------------------------------------------- 7. GMU 的地址空间 */
+
+#define GMU_ITCM_ADDRESS        0x00000000u
+#define GMU_DTCM_ADDRESS        0x10004000u     /* kgsl_gmu.c gmu_vma（a650 家族）：SZ_256M + SZ_16K */
+#define GMU_TCM_SIZE            0x4000u
+#define GMU_LOG_ADDRESS         0x60002000u     /* 固件自己要的 0x60000000 一页之后 */
+#define GMU_LOG_SIZE            0x4000u
+#define GMU_HFI_ADDRESS         0x60006000u
+#define GMU_STREAM              5u              /* 设备树 gmu_kernel iommus = <kgsl_smmu 5 0x400> */
+
+struct gmu_fw_block {
+	uint32_t address, size, type, value;
+};
+
+static struct gpu_space gmu_space = { .name = "the GMU", .context = 1 };
+static uint32_t gmu_match = 1;
+static struct gpu_block gmu_blocks[12], gmu_log, gmu_hfi;
+static unsigned gmu_block_count;
+static const uint8_t *gmu_fw;
+static unsigned int gmu_fw_size;
+static bool gmu_space_is_on, gmu_runs, gmu_talks, core_is_on, rsc_awake;
+
+static bool
+in_tcm(uint32_t address)
+{
+	return address - GMU_ITCM_ADDRESS < GMU_TCM_SIZE || address - GMU_DTCM_ADDRESS < GMU_TCM_SIZE;
+}
+
+/* 固件在 ADT 的 /picasso-gpu 里（tools/mkadt.py 从 research/picasso-gpu-fw/ 放进去） */
+static const uint8_t *
+fw_file(const char *name, unsigned int *size)
+{
+	DTEntry node;
+	void const *prop = NULL;
+	if (SecureDTLookupEntry(NULL, "/picasso-gpu", &node) != kSuccess) {
+		printf(TAG ": %u: no /picasso-gpu in the ADT (tools/picasso-gpu-fw.py, then tools/mkadt.py)\n", step);
+		return NULL;
+	}
+	if (SecureDTGetProperty(node, name, &prop, size) != kSuccess || *size == 0) {
+		printf(TAG ": %u: the ADT's /picasso-gpu has no %s\n", step, name);
+		return NULL;
+	}
+	printf(TAG ": %u: %s: %u bytes from the ADT\n", step, name, *size);
+	return (const uint8_t *)prop;
+}
+
+static bool
+step_space(void)
+{
+	if (!cx_ready()) {
+		return false;
+	}
+	announce("take the GMU's firmware (a650_gmu.bin) from the ADT; make the memory it asks for");
+	gmu_fw = fw_file("a650_gmu.bin", &gmu_fw_size);
+	if (gmu_fw == NULL) {
+		return false;
+	}
+	for (unsigned at = 0; at + sizeof(struct gmu_fw_block) <= gmu_fw_size;) {
+		struct gmu_fw_block b;
+		memcpy(&b, gmu_fw + at, sizeof(b));
+		at += sizeof(b) + b.size;
+		if (at > gmu_fw_size) {
+			printf(TAG ": %u: the firmware ends inside a block\n", step);
+			return false;
+		}
+		/* 类型 1 / 7、没有数据：固件要的内存，value = 字节数（a6xx_gmu_load_firmware 的 gmu_prealloc_req） */
+		if (b.size != 0 || (b.type != 1 && b.type != 7) || in_tcm(b.address)) {
+			continue;
+		}
+		if (gmu_block_count == sizeof(gmu_blocks) / sizeof(gmu_blocks[0]) || (b.address & 4095) ||
+		    b.value > 0x100000 || !block_new(&gmu_space, &gmu_blocks[gmu_block_count++], b.address, b.value)) {
+			printf(TAG ": %u: cannot make %#x bytes at %#x for the firmware\n", step, b.value, b.address);
+			return false;
+		}
+	}
+	if (!block_new(&gmu_space, &gmu_log, GMU_LOG_ADDRESS, GMU_LOG_SIZE) ||
+	    !block_new(&gmu_space, &gmu_hfi, GMU_HFI_ADDRESS, PAGE_SIZE)) {
+		return false;
+	}
+	(void)PE_parse_boot_argn("picassogmucb", &gmu_space.context, sizeof(gmu_space.context));
+	(void)PE_parse_boot_argn("picassogmusmr", &gmu_match, sizeof(gmu_match));
+	announce("give SMMU context 1 these tables and send the GMU's stream 5 through it: the first SMMU writes");
+	if (!smmu_layout() || gmu_space.context >= smmu_contexts || gmu_match >= smmu_matches) {
+		printf(TAG ": %u: context %u / match %u not on this SMMU\n", step, gmu_space.context, gmu_match);
+		return false;
+	}
+	gmu_space_is_on = true;
+	return space_on(&gmu_space, gmu_match, GMU_STREAM);
+}
+
+/* ---------------------------------------------------------------- 8. RSC 和 PDC 微码 */
+
+static bool
+step_rpmh(void)
+{
+	uint32_t xo = rpmh_resource("xo.lvl", NULL, NULL), cx = rpmh_resource("cx.lvl", NULL, NULL);
+	uint32_t mx = rpmh_resource("mx.lvl", NULL, NULL), vrm = rpmh_resource("vrm.soc", NULL, NULL);
+	if (!cx_ready()) {
+		return false;
+	}
+	if (!xo || !cx || !mx) {
+		printf(TAG ": %u: cmd-db lacks xo.lvl %#x / cx.lvl %#x / mx.lvl %#x\n", step, xo, cx, mx);
+		return false;
+	}
+	announce("the GMU's RPMh channel its sleep/wake program (rscc 0x3de0000; adreno_a6xx_gmu.c a6xx_load_rsc_ucode)");
+	put(&rscc, "rsc_status0 (SDE clock gating off)", RSCC_RSC_STATUS0, 1u << 24);
+	put(&rscc, "pdc_slave_id", RSCC_PDC_SLAVE_ID, 1);
+	put(&rscc, "hidden_tcs0_data", RSCC_HIDDEN_TCS_DATA(0), 0);
+	put(&rscc, "hidden_tcs0_addr", RSCC_HIDDEN_TCS_ADDR(0), 0);
+	put(&rscc, "hidden_tcs1_data", RSCC_HIDDEN_TCS_DATA(1), 0);
+	put(&rscc, "hidden_tcs1_addr", RSCC_HIDDEN_TCS_ADDR(1), 0);
+	put(&rscc, "hidden_tcs2_data", RSCC_HIDDEN_TCS_DATA(2), 0x80000000);
+	put(&rscc, "hidden_tcs2_addr", RSCC_HIDDEN_TCS_ADDR(2), 0);
+	put(&rscc, "override_start", RSCC_OVERRIDE_START, 0);
+	put(&rscc, "pdc_seq_start", RSCC_PDC_SEQ_START, 0x4520);
+	put(&rscc, "pdc_match_lo", RSCC_PDC_MATCH_LO, 0x4510);
+	put(&rscc, "pdc_match_hi", RSCC_PDC_MATCH_HI, 0x4514);
+	for (unsigned i = 0; i < 5; i++) {
+		put(&rscc, "seq_mem", RSCC_SEQ_MEM_0 + 4 * i, rsc_program[i]);
+	}
+	announce("the GPU's PDC sequencer and its two command sets (AOSS 0xb490000 / 0xb290000: not touched before; "
+	    "a620 has no pdc_in_aop, so the vendor's driver writes these too)");
+	static const uint32_t pdc_program[5] = { 0xfebea1e1, 0xa5a4a3a2, 0x8382a6e0, 0xbce3e284, 0x002081fc };
+	for (unsigned i = 0; i < 5; i++) {
+		put(&pdc_seq, "seq_mem", 4 * i, pdc_program[i]);
+	}
+	/* TCS1（低功耗进入）与 TCS3（退出）：mx、cx、xo，a620 还有 vrm.soc + 4 */
+	const struct {
+		uint32_t tcs, mx, cx, xo, vrm;
+	} sets[2] = { { PDC_TCS1, 1, 0, 0, 0 }, { PDC_TCS3, 2, 2, 3, 1 } };
+	for (unsigned s = 0; s < 2; s++) {
+		uint32_t t = sets[s].tcs;
+		put(&pdc_cfg, "tcs enable_bank", t + 4, 7);
+		put(&pdc_cfg, "tcs wait_bank", t + 8, 0);
+		put(&pdc_cfg, "tcs control", t, 0);
+		const uint32_t addr[4] = { mx, cx, xo, vrm ? vrm + 4 : 0 };
+		const uint32_t data[4] = { sets[s].mx, sets[s].cx, sets[s].xo, sets[s].vrm };
+		for (unsigned n = 0; n < 4; n++) {
+			if (addr[n] == 0) {
+				continue;
+			}
+			put(&pdc_cfg, "tcs cmd msgid", PDC_CMD(t, n, 0), 0x10108);
+			put(&pdc_cfg, "tcs cmd addr", PDC_CMD(t, n, 1), addr[n]);
+			put(&pdc_cfg, "tcs cmd data", PDC_CMD(t, n, 2), data[n]);
+		}
+	}
+	put(&pdc_cfg, "gpu seq_start", PDC_SEQ_START, 0);
+	put(&pdc_cfg, "gpu enable", PDC_ENABLE, 0x80000001);
+	settle();
+	get(&pdc_cfg, "gpu enable", PDC_ENABLE);
+	get(&rscc, "seq_mem_0", RSCC_SEQ_MEM_0);
+	return true;
+}
+
+/* ---------------------------------------------------------------- 9. 固件进 GMU */
+
+static bool
+step_load(void)
+{
+	uint32_t wrong = 0;
+	if (!cx_ready() || gmu_fw == NULL || !gmu_space_is_on) {
+		return false;
+	}
+	announce("load the GMU's firmware: code and data memory through its registers (0x3d6d000, 0x3d71000), "
+	    "the rest into our memory");
+	put(&gmu, "cm3_sysreset", GMU_CM3_SYSRESET, 1);
+	put(&gmu, "general_7 (TCM retention)", GMU_GENERAL_7, 1);
+	for (int pass = 0; pass < 2; pass++) {
+		for (unsigned at = 0; at + sizeof(struct gmu_fw_block) <= gmu_fw_size;) {
+			struct gmu_fw_block b;
+			memcpy(&b, gmu_fw + at, sizeof(b));
+			const uint8_t *data = gmu_fw + at + sizeof(b);
+			at += sizeof(b) + b.size;
+			if (b.size == 0) {
+				continue;
+			}
+			if (in_tcm(b.address) && in_tcm(b.address + b.size - 1)) {
+				uint32_t regs = b.address < GMU_DTCM_ADDRESS ? GMU_ITCM + b.address - GMU_ITCM_ADDRESS :
+				    GMU_DTCM + b.address - GMU_DTCM_ADDRESS;
+				for (uint32_t off = 0; off + 4 <= b.size; off += 4) {
+					uint32_t w;
+					memcpy(&w, data + off, 4);
+					if (pass == 0) {
+						wr(gmu.base + regs + off, w);
+					} else if (rd(gmu.base + regs + off) != w) {
+						wrong++;
+					}
+				}
+				if (pass == 1) {
+					printf(TAG ": %u: %#x bytes at the GMU's %#x, through its registers\n", step, b.size, b.address);
+				}
+				continue;
+			}
+			for (unsigned i = 0; pass == 0 && i <= gmu_block_count; i++) {
+				if (i == gmu_block_count) {
+					printf(TAG ": %u: %#x bytes for %#x, where the firmware asked for no memory\n", step, b.size,
+					    b.address);
+					return false;
+				}
+				if (b.address >= gmu_blocks[i].address &&
+				    b.address + b.size <= gmu_blocks[i].address + gmu_blocks[i].size) {
+					memcpy((void *)(gmu_blocks[i].memory + (b.address - gmu_blocks[i].address)), data, b.size);
+					to_memory(gmu_blocks[i].memory, gmu_blocks[i].size);
+					printf(TAG ": %u: %#x bytes at the GMU's %#x, in memory\n", step, b.size, b.address);
+					break;
+				}
+			}
+		}
+	}
+	snprintf(last_write, sizeof(last_write), "step %u wrote the GMU firmware", step);
+	if (wrong) {
+		printf(TAG ": %u: %u words of the GMU's TCM do not read back\n", step, wrong);
+		return false;
+	}
+	printf(TAG ": %u: THE GMU'S FIRMWARE IS LOADED: core %#x, power %#x, HFI %#x\n", step,
+	    rd(gmu.base + GMU_DTCM_VERSIONS), rd(gmu.base + GMU_DTCM_VERSIONS + 8), rd(gmu.base + GMU_DTCM_VERSIONS + 16));
+	return true;
+}
+
+/* ---------------------------------------------------------------- 10. 放开 GMU */
+
+struct hfi_queue {
+	uint32_t status, start, type, words, message_words, unused[5], read, write;
+};
+struct hfi_table {
+	uint32_t version, words, first_queue, queue_words, queues, active_queues;
+	struct hfi_queue queue[4];
+};
+#define HFI_QUEUES              3
+#define HFI_QUEUE_WORDS         1024
+#define HFI_QUEUE_AT(n)         ((((uint32_t)sizeof(struct hfi_table) + 15) / 16 * 16) + 4096 * (n))
+static volatile struct hfi_table *hfi;
+
+static void gmu_post_mortem(void);
+
+static bool
+step_start(void)
+{
+	static const uint8_t priority[HFI_QUEUES] = { 10, 10, 40 };
+	uint32_t result = 0;
+	if (!cx_ready() || !gmu_space_is_on) {
+		return false;
+	}
+	hfi = (volatile struct hfi_table *)block_uncached(&gmu_hfi);
+	if (hfi == NULL) {
+		printf(TAG ": %u: the HFI page is not in one piece\n", step);
+		return false;
+	}
+	hfi->version = 0;
+	hfi->words = sizeof(struct hfi_table) / 4;
+	hfi->first_queue = 6;
+	hfi->queue_words = sizeof(struct hfi_queue) / 4;
+	hfi->queues = 4;
+	hfi->active_queues = HFI_QUEUES;
+	for (unsigned i = 0; i < HFI_QUEUES; i++) {
+		hfi->queue[i].start = GMU_HFI_ADDRESS + HFI_QUEUE_AT(i);
+		hfi->queue[i].type = i | (uint32_t)priority[i] << 8;
+		hfi->queue[i].words = HFI_QUEUE_WORDS;
+		hfi->queue[i].read = hfi->queue[i].write = 0;
+		hfi->queue[i].status = 1;
+	}
+	settle();
+
+	announce("configure the GMU (adreno_a6xx_gmu.c a6xx_gmu_fw_start order) and let its CM3 out of reset");
+	if (get(&gmu, "cm3_sysreset", GMU_CM3_SYSRESET) != 1) {
+		printf(TAG ": %u: the CM3 is not held in reset\n", step);
+		return false;
+	}
+	rscc_show();
+	if (rd(rscc.base + RSCC_RSC_STATUS0) & RSCC_ASLEEP) {
+		/* 上一个内核让 RSC 睡下了：先叫醒（原厂 a6xx_rpmh_power_on_gpu） */
+		put(&gmu, "rscc_control_req", GMU_RSCC_CONTROL_REQ, 2);
+		if (!wait_for(&gmu, GMU_RSCC_CONTROL_ACK, 2, 2, 100) || !wait_for(&rscc, RSCC_SEQ_BUSY, ~0u, 0, 100)) {
+			printf(TAG ": %u: the GMU's RPMh channel does not wake\n", step);
+		}
+		put(&gmu, "rscc_control_req", GMU_RSCC_CONTROL_REQ, 0);
+		get(&rscc, "rsc_status0", RSCC_RSC_STATUS0);
+	}
+	rsc_awake = true;
+	put(&gmu, "cx_fal_intf (veto_fal10)", GMU_CX_FAL_INTF, 1);
+	put(&gmu, "cm3_fw_init_result", GMU_CM3_FW_INIT_RESULT, 0);
+	put(&gmu, "cm3_boot_config (TCM_BOOT)", GMU_CM3_BOOT_CONFIG, 2);
+	put(&gmu, "hfi_qtbl_addr", GMU_HFI_QTBL_ADDR, GMU_HFI_ADDRESS);
+	put(&gmu, "hfi_qtbl_info", GMU_HFI_QTBL_INFO, 1);
+	put(&gmu, "ahb_fence_range_0", GMU_AHB_FENCE_RANGE_0, GMU_FENCE_RANGE);
+	put(&gmu, "cm3_cfg", GMU_CM3_CFG, 0x4052);
+	put(&gmu, "hfi_sfr_addr (chip)", GMU_HFI_SFR_ADDR, GMU_CHIP);
+	put(&gmu, "pwr_col_cp_msg (log)", GMU_PWR_COL_CP_MSG, (GMU_LOG_ADDRESS & 0xfffff000u) | (GMU_LOG_SIZE / 4096 - 1));
+	put(&gmu, "sys_bus_config", GMU_SYS_BUS_CONFIG, 1);
+	put(&gmu, "icache_config", GMU_ICACHE_CONFIG, 1);
+	put(&gmu, "dcache_config", GMU_DCACHE_CONFIG, 1);
+	put(&gmu, "pwr_col_inter_frame_ctrl", GMU_PWR_COL_INTER_FRAME_CTRL, 0x9c40400);
+	set(&gmu, "rpmh_ctrl", GMU_RPMH_CTRL, GMU_RPMH_CTRL_ALL);
+	put(&gmu, "gmu2host_intr_clr", GMU_GMU2HOST_INTR_CLR, 0xffffffff);
+	put(&gbif, "halt", GBIF_HALT, 0);
+	put(&gmu, "pwr_col_cp_resp", GMU_PWR_COL_CP_RESP, 0);
+	gmu_runs = true;
+	put(&gmu, "cm3_sysreset", GMU_CM3_SYSRESET, 0);
+	settle();
+	for (int i = 0; i < 2000 && (result & GMU_STARTED_MASK) != GMU_STARTED && !(result & GMU_FAILED); i++) {
+		sleep_us(100);
+		result = rd(gmu.base + GMU_CM3_FW_INIT_RESULT);
+	}
+	get(&gmu, "cm3_fw_init_result", GMU_CM3_FW_INIT_RESULT);
+	get(&gmu, "gmu2host_intr_info", GMU_GMU2HOST_INTR_INFO);
+	get(&gmu, "hfi_ctrl_status", GMU_HFI_CTRL_STATUS);
+	if (space_faulted(&gmu_space) || (result & GMU_STARTED_MASK) != GMU_STARTED) {
+		printf(TAG ": %u: the GMU's firmware does not come up (breadcrumb %#x)\n", step,
+		    rd(gmu.base + GMU_DTCM + 0x3fdc));
+		gmu_post_mortem();
+		return false;
+	}
+	printf(TAG ": %u: THE GMU'S FIRMWARE RUNS\n", step);
+	return true;
+}
+
+/* ---------------------------------------------------------------- 11. HFI */
+
+static bool
+step_hfi(void)
+{
+	if (!cx_ready() || !gmu_runs) {
+		return false;
+	}
+	announce("ask the GMU to start its message queues (HFI)");
+	put(&gmu, "hfi_ctrl_init", GMU_HFI_CTRL_INIT, 1);
+	if (!wait_for(&gmu, GMU_HFI_CTRL_STATUS, 1, 1, 100)) {
+		get(&gmu, "hfi_ctrl_status", GMU_HFI_CTRL_STATUS);
+		get(&gmu, "cm3_fw_init_result", GMU_CM3_FW_INIT_RESULT);
+		space_faulted(&gmu_space);
+		printf(TAG ": %u: the GMU does not start its message queues\n", step);
+		gmu_post_mortem();
+		return false;
+	}
+	get(&gmu, "hfi_version_info", GMU_HFI_VERSION_INFO);
+	gmu_talks = true;
+	printf(TAG ": %u: THE GMU'S MESSAGE QUEUES ARE UP\n", step);
+	return !space_faulted(&gmu_space);
+}
+
+/* ---------------------------------------------------------------- 12/13. 和 GMU 说话，GX 上电 */
+
+#define HFI_BW_TABLE            3
+#define HFI_PERF_TABLE          4
+#define HFI_START               10
+#define HFI_CORE_FW_START       14
+#define HFI_GX_BW_PERF_VOTE     30
+#define HFI_PREPARE_SLUMBER     33
+#define HFI_ERROR               100
+#define HFI_ANSWER              1
+
+struct hfi_perf_table {
+	uint32_t header, gpu_levels, gmu_levels;
+	struct {
+		uint32_t vote, acd, khz;
+	} gpu[16];
+	struct {
+		uint32_t vote, khz;
+	} gmu[4];
+};
+struct hfi_bw_table {
+	uint32_t header, levels, cnoc_commands, ddr_commands, cnoc_wait, ddr_wait;
+	uint32_t cnoc_address[6], cnoc_data[2][6], ddr_address[8], ddr_data[16][8];
+};
+static uint32_t hfi_number;
+static bool post_mortem_done;
+
+static bool
+hfi_receive(unsigned which, uint32_t number, uint32_t *verdict)
+{
+	volatile struct hfi_queue *q = &hfi->queue[which];
+	volatile uint32_t *data = (volatile uint32_t *)((vm_offset_t)hfi + HFI_QUEUE_AT(which));
+	bool answered = false;
+	for (int guard = 0; q->read != q->write && guard < 64; guard++) {
+		uint32_t m[8] = { 0 }, at = q->read % HFI_QUEUE_WORDS, words = data[at] >> 8 & 0xff;
+		for (uint32_t i = 0; i < words; i++) {
+			if (i < 8) {
+				m[i] = data[at];
+			}
+			at = (at + 1) % HFI_QUEUE_WORDS;
+		}
+		q->read = (at + 3) / 4 * 4 % HFI_QUEUE_WORDS;
+		if ((m[0] >> 16 & 0xf) == HFI_ANSWER && m[1] >> 20 == number) {
+			*verdict = m[2];
+			answered = true;
+		} else if ((m[0] & 0xff) == HFI_ERROR) {
+			m[7] = 0;
+			printf(TAG ": %u: THE GMU REPORTS AN ERROR: %u, %u, \"%s\"\n", step, m[1] >> 16, m[1] & 0xffff,
+			    (const char *)&m[2]);
+		} else {
+			printf(TAG ": %u: the GMU says (queue %u, %u words): %#x %#x %#x %#x %#x %#x\n", step, which, words,
+			    m[0], m[1], m[2], m[3], m[4], m[5]);
+		}
+		if (words == 0) {
+			break;
+		}
+	}
+	return answered;
+}
+
+static void
+gmu_post_mortem(void)
+{
+	if (post_mortem_done) {
+		return;
+	}
+	post_mortem_done = true;
+	uint32_t next = rd(gmu.base + GMU_PWR_COL_CP_RESP) & 0xffff, entries = GMU_LOG_SIZE / 16;
+	const volatile uint32_t *log = (const volatile uint32_t *)gmu_log.memory;
+	if (gmu_log.memory) {
+		to_memory(gmu_log.memory, GMU_LOG_SIZE);
+		printf(TAG ": %u: the GMU's log, %u events in, the last 32:\n", step, next);
+		for (uint32_t i = next > 32 ? next - 32 : 0; i < next && i + 4 <= entries; i += 4) {
+			printf(TAG ": %u:   %x %x %x %x | %x %x %x %x | %x %x %x %x | %x %x %x %x\n", step,
+			    log[4 * i], log[4 * i + 1], log[4 * i + 2], log[4 * i + 3], log[4 * i + 4], log[4 * i + 5],
+			    log[4 * i + 6], log[4 * i + 7], log[4 * i + 8], log[4 * i + 9], log[4 * i + 10], log[4 * i + 11],
+			    log[4 * i + 12], log[4 * i + 13], log[4 * i + 14], log[4 * i + 15]);
+		}
+	}
+	rscc_show();
+	get(&gpucc, "gx_gdscr", CC_GX_GDSCR);
+	get(&gpucc, "gx_domain_misc", CC_GX_DOMAIN_MISC);
+	get(&gpucc, "pll0 mode", CC_PLL0_MODE);
+	get(&gmu, "rpmh_power_state", GMU_RPMH_POWER_STATE);
+	get(&gmu, "sptprac_pwr_clk_status", GMU_SPTPRAC_PWR_CLK_STATUS);
+	get(&gmu, "ao_host_interrupt_status", GMU_AO_HOST_INTR_STATUS);
+	get(&gmu, "ahb_fence_status", GMU_AHB_FENCE_STATUS);
+}
+
+static bool
+hfi_send(const char *what, uint32_t id, uint32_t *message, uint32_t words)
+{
+	volatile struct hfi_queue *q = &hfi->queue[0];
+	volatile uint32_t *data = (volatile uint32_t *)((vm_offset_t)hfi + HFI_QUEUE_AT(0));
+	uint32_t at = q->write % HFI_QUEUE_WORDS, number = ++hfi_number & 0xfff, verdict = 0, waiting = 0;
+	bool answered = false;
+	message[0] = id | words << 8 | number << 20;
+	printf(TAG ": %u: send the GMU %s: message %u, %u words, number %u\n", step, what, id, words, number);
+	snprintf(last_write, sizeof(last_write), "step %u sent the GMU message %u", step, id);
+	for (uint32_t i = 0; i < (words + 3) / 4 * 4; i++) {
+		data[at] = i < words ? message[i] : 0xfafafafa;
+		at = (at + 1) % HFI_QUEUE_WORDS;
+	}
+	q->write = at;
+	settle();
+	wr(gmu.base + GMU_HOST2GMU_INTR_SET, 1);
+	for (int i = 0; i < 2000 && !answered; i++) {
+		sleep_us(100);
+		waiting = rd(gmu.base + GMU_GMU2HOST_INTR_INFO);
+		if (waiting & 1) {
+			wr(gmu.base + GMU_GMU2HOST_INTR_CLR, 1);
+			answered = hfi_receive(1, number, &verdict);
+		}
+		if (rd(gmu.base + GMU_CM3_FW_INIT_RESULT) & GMU_FAILED) {
+			break;
+		}
+	}
+	hfi_receive(2, ~0u, &waiting);
+	if (!answered || verdict != 0) {
+		printf(TAG ": %u: the GMU %s (%#x) to %s; fw_init_result %#x, gmu2host_intr_info %#x\n", step,
+		    answered ? "says no" : "does not answer", verdict, what, rd(gmu.base + GMU_CM3_FW_INIT_RESULT),
+		    rd(gmu.base + GMU_GMU2HOST_INTR_INFO));
+		space_faulted(&gmu_space);
+		gmu_post_mortem();
+		return false;
+	}
+	printf(TAG ": %u: the GMU accepts %s\n", step, what);
+	return true;
+}
+
+/* 电压投票：等级、它在 RPMh 列表里的位置、对应的 mx 等级位置（kgsl_gmu.c setup_volt_dependency_tbl、ARC_VOTE_SET） */
+static bool
+rail_vote(uint32_t level, const uint16_t *rail, unsigned rail_levels, const uint16_t *mx, unsigned mx_levels, uint32_t *vote)
+{
+	unsigned at, with = 0;
+	for (at = 0; at < rail_levels && rail[at] < level; at++) {
+	}
+	if (at == rail_levels || mx_levels == 0) {
+		return false;
+	}
+	while (with + 1 < mx_levels && mx[with] < rail[at]) {
+		with++;
+	}
+	*vote = (uint32_t)rail[at] << 16 | with << 8 | at;
+	return true;
+}
+
+/* gpu-opp-table 里最低的三档（小米这台最高 750 MHz，第一次上电只用到 500 MHz） */
+static const struct {
+	uint32_t khz, level;
+} speeds[] = { { 0, 0 }, { 275000, 64 }, { 400000, 128 }, { 500000, 192 } };
+static uint32_t speed_index = 2;
+
+static bool
+step_tables(void)
+{
+	static struct hfi_perf_table perf;
+	static struct hfi_bw_table bw;
+	uint32_t core_start[2] = { 0, 0 }, vote[4] = { 0, 1, 0, 0xff };      /* ack_type 1、频率档、带宽不变 */
+	uint16_t gfx[16], cx[16], mx[16];
+	unsigned gfx_n, cx_n, mx_n;
+	if (!cx_ready() || !gmu_talks) {
+		return false;
+	}
+	if (!rpmh_resource("gfx.lvl", gfx, &gfx_n) || !rpmh_resource("cx.lvl", cx, &cx_n) ||
+	    !rpmh_resource("mx.lvl", mx, &mx_n)) {
+		printf(TAG ": %u: cmd-db lacks a rail\n", step);
+		return false;
+	}
+	bzero(&perf, sizeof(perf));
+	bzero(&bw, sizeof(bw));
+	perf.gpu_levels = sizeof(speeds) / sizeof(speeds[0]);
+	for (unsigned i = 0; i < perf.gpu_levels; i++) {
+		perf.gpu[i].khz = speeds[i].khz;
+		perf.gpu[i].acd = 0xffffffff;
+		if (!rail_vote(speeds[i].level, gfx, gfx_n, mx, mx_n, &perf.gpu[i].vote)) {
+			printf(TAG ": %u: gfx.lvl has no level %u\n", step, speeds[i].level);
+			return false;
+		}
+	}
+	perf.gmu_levels = 2;
+	perf.gmu[1].khz = 200000;
+	if (!rail_vote(0, cx, cx_n, mx, mx_n, &perf.gmu[0].vote) || !rail_vote(48, cx, cx_n, mx, mx_n, &perf.gmu[1].vote)) {
+		printf(TAG ": %u: cx.lvl has no level for the GMU\n", step);
+		return false;
+	}
+	printf(TAG ": %u: votes: 3D core %#x %#x %#x %#x, GMU %#x %#x\n", step, perf.gpu[0].vote, perf.gpu[1].vote,
+	    perf.gpu[2].vote, perf.gpu[3].vote, perf.gmu[0].vote, perf.gmu[1].vote);
+	/* 只有"关"一档的带宽表（HackiOS / Linux adreno_7c3_build_bw_table 的做法）：DDR 投票最低，先求能亮 */
+	bw.levels = 1;
+	bw.ddr_commands = 3;
+	bw.ddr_wait = 7;
+	bw.ddr_address[0] = rpmh_resource("SH0", NULL, NULL);
+	bw.ddr_address[1] = rpmh_resource("MC0", NULL, NULL);
+	bw.ddr_address[2] = rpmh_resource("ACV", NULL, NULL);
+	bw.ddr_data[0][0] = bw.ddr_data[0][1] = bw.ddr_data[0][2] = 0x40000000;
+	bw.cnoc_commands = 1;
+	bw.cnoc_wait = 1;
+	bw.cnoc_address[0] = rpmh_resource("CN0", NULL, NULL);
+	bw.cnoc_data[0][0] = 0x40000000;
+	bw.cnoc_data[1][0] = 0x60000001;
+	if (!bw.ddr_address[0] || !bw.ddr_address[1] || !bw.ddr_address[2] || !bw.cnoc_address[0]) {
+		printf(TAG ": %u: cmd-db lacks a bus resource (SH0 %#x MC0 %#x ACV %#x CN0 %#x)\n", step, bw.ddr_address[0],
+		    bw.ddr_address[1], bw.ddr_address[2], bw.cnoc_address[0]);
+		return false;
+	}
+	(void)PE_parse_boot_argn("picassogpuspeed", &speed_index, sizeof(speed_index));
+	if (speed_index < 1 || speed_index >= perf.gpu_levels) {
+		speed_index = 2;
+	}
+	vote[2] = speed_index;
+	announce("send the GMU its tables (speeds, bus), CORE_FW_START, and the speed wanted");
+	return hfi_send("the table of speeds", HFI_PERF_TABLE, &perf.header, sizeof(perf) / 4) &&
+	       hfi_send("the table of bus votes", HFI_BW_TABLE, &bw.header, sizeof(bw) / 4) &&
+	       hfi_send("CORE_FW_START", HFI_CORE_FW_START, core_start, 2) &&
+	       hfi_send("the speed wanted", HFI_GX_BW_PERF_VOTE, vote, 4);
+}
+
+#define GMU_OOB_GPU_SET         (1u << 30)
+#define GMU_OOB_GPU_ACK         (1u << 31)
+#define GMU_OOB_GPU_CLEAR       (1u << 31)
+
+static bool
+step_gx(void)
+{
+	uint32_t start[1] = { 0 }, granted = 0;
+	if (!cx_ready() || !gmu_talks) {
+		return false;
+	}
+	announce("ask the GMU to power the 3D core (OOB GPU) and keep it powered");
+	get(&gmu, "sptprac_pwr_clk_status", GMU_SPTPRAC_PWR_CLK_STATUS);
+	get(&gpucc, "gx_gdscr", CC_GX_GDSCR);
+	put(&gmu, "host2gmu_intr_set (OOB GPU)", GMU_HOST2GMU_INTR_SET, GMU_OOB_GPU_SET);
+	for (int i = 0; i < 2000 && !(granted & GMU_OOB_GPU_ACK); i++) {
+		sleep_us(100);
+		granted = rd(gmu.base + GMU_GMU2HOST_INTR_INFO);
+	}
+	core_is_on = true;
+	put(&gmu, "gmu2host_intr_clr", GMU_GMU2HOST_INTR_CLR, GMU_OOB_GPU_ACK);
+	uint32_t status = get(&gmu, "sptprac_pwr_clk_status", GMU_SPTPRAC_PWR_CLK_STATUS);
+	get(&gpucc, "gx_gdscr", CC_GX_GDSCR);
+	get(&gpucc, "pll0 mode", CC_PLL0_MODE);
+	get(&gmu, "rpmh_power_state", GMU_RPMH_POWER_STATE);
+	if (!(granted & GMU_OOB_GPU_ACK) || (status & 0xc0) != 0) {
+		printf(TAG ": %u: the GMU does not power the 3D core (gmu2host_intr_info %#x, fw_init_result %#x)\n", step,
+		    granted, rd(gmu.base + GMU_CM3_FW_INIT_RESULT));
+		space_faulted(&gmu_space);
+		gmu_post_mortem();
+		return false;
+	}
+	if (!hfi_send("START", HFI_START, start, 1)) {
+		return false;
+	}
+	announce("read registers of the 3D core itself (0x3d00000): the first time it has power");
+	get(&gpu, "rbbm_status", RBBM_STATUS);
+	get(&gpu, "rbbm_int_0_status", RBBM_INT_0_STATUS);
+	get(&gpu, "rbbm_clock_cntl", RBBM_CLOCK_CNTL);
+	get(&gpu, "cp_rb_base", CP_RB_BASE);
+	printf(TAG ": %u: THE 3D CORE HAS POWER AND ANSWERS (%u MHz asked for)\n", step, speeds[speed_index].khz / 1000);
+	return !space_faulted(&gmu_space);
+}
+
+/* ---------------------------------------------------------------- 撤回 */
+
+static void
+gx_off(void)
+{
+	uint32_t gx = get(&gpucc, "gx_gdscr", CC_GX_GDSCR);
+	if (gx & GDSC_POWER_ON) {
+		put(&gpucc, "gx_gdscr", CC_GX_GDSCR, gx | GDSC_SW_COLLAPSE);
+		wait_for(&gpucc, CC_GX_GDSCR, GDSC_POWER_ON, 0, 100);
+		get(&gpucc, "gx_gdscr", CC_GX_GDSCR);
+	}
+}
+
+static void
+gpu_block_stop(void)
+{
+	uint32_t slumber[3] = { 0, 0, 0 };
+	step = 99;
+	newest_step = ~0u;
+	printf(TAG ": --- giving everything back, in reverse\n");
+	if (core_is_on) {
+		put(&gmu, "host2gmu_intr_set (OOB GPU clear)", GMU_HOST2GMU_INTR_SET, GMU_OOB_GPU_CLEAR);
+		core_is_on = false;
+	}
+	if (gmu_talks) {
+		put(&gmu, "power_counter_enable", GMU_POWER_COUNTER_EN, 0);
+		hfi_send("PREPARE_SLUMBER", HFI_PREPARE_SLUMBER, slumber, 3);
+		put(&gmu, "ao_ahb_fence_ctrl (allow)", GMU_AO_AHB_FENCE_CTRL, 0);
+		if (!wait_for(&gmu, GMU_AO_GPU_CX_BUSY, 1u << 23, 0, 100)) {
+			get(&gmu, "ao_gpu_cx_busy", GMU_AO_GPU_CX_BUSY);
+		}
+		gmu_talks = false;
+	}
+	if (gmu_runs) {
+		put(&gmu, "ahb_fence_status_clr", GMU_AHB_FENCE_STATUS_CLR, 7);
+		put(&gmu, "cm3_sysreset", GMU_CM3_SYSRESET, 1);
+		gmu_runs = false;
+		gx_off();
+	}
+	if (rsc_awake && rd(rscc.base + RSCC_SEQ_MEM_0) == rsc_program[0]) {
+		/* 原厂 a6xx_rpmh_power_off_gpu：RSC 睡下，GMU 的 RPMh 投票由常开定序器撤掉 */
+		put(&gmu, "rscc_control_req", GMU_RSCC_CONTROL_REQ, 1);
+		if (!wait_for(&rscc, RSCC_RSC_STATUS0, RSCC_ASLEEP, RSCC_ASLEEP, 100)) {
+			printf(TAG ": the GMU's RPMh channel does not go to sleep\n");
+		}
+		get(&rscc, "rsc_status0", RSCC_RSC_STATUS0);
+		put(&gmu, "rscc_control_req", GMU_RSCC_CONTROL_REQ, 0);
+	}
+	rsc_awake = false;
+	if (gmu_space_is_on) {
+		space_faulted(&gmu_space);
+		space_off(&gmu_space, gmu_match);
+		gmu_space_is_on = false;
+	}
+	if (cx_powered_here && gpucc.base) {
+		put(&gpucc, "cx_gdscr", CC_CX_GDSCR, rd(gpucc.base + CC_CX_GDSCR) | GDSC_SW_COLLAPSE);
+		for (int i = 0; i < 1000 && cx_is_on(); i++) {
+			sleep_us(100);
+		}
+		get(&gpucc, "cx_gdscr", CC_CX_GDSCR);
+		get(&gpucc, "cx_hw_ctrl", CC_CX_HW_CTRL);
+		cx_powered_here = false;
+	}
+	printf(TAG ": --- the GPU block is as the phone's start left it (memory we gave it is kept, never reused)\n");
+}
+
+/* ---------------------------------------------------------------- 入口 */
+
+static bool(*const steps[])(void) = {
+	step_cx, step_words, step_rscc, step_smmu, step_tcm, step_cmd_db, step_space, step_rpmh, step_load,
+	step_start, step_hfi, step_tables, step_gx,
+};
+#define STEPS ((uint32_t)(sizeof(steps) / sizeof(steps[0])))
+
+void
+picasso_adreno_run(void)
+{
+	uint32_t last = STEPS, watch = 10, done = 0;
+	(void)PE_parse_boot_argn("picassoadreno", &last, sizeof(last));
+	(void)PE_parse_boot_argn("picassogpuslow", &pause_ms, sizeof(pause_ms));
+	(void)PE_parse_boot_argn("picassogpuwatch", &watch, sizeof(watch));
+	if (last == 0 || last > STEPS) {
+		last = STEPS;
+	}
+	if (pause_ms > 10000) {
+		pause_ms = 10000;
+	}
+	if (watch > 120) {
+		watch = 120;
+	}
+	newest_step = last;
+	printf(TAG ": steps 1..%u of %u; step %u is the new one and waits %u ms after each announcement\n", last, STEPS,
+	    newest_step, pause_ms);
+	for (step = 1; step <= last; step++) {
+		if (!steps[step - 1]()) {
+			printf(TAG ": step %u: FAILED; the steps after it are not attempted\n", step);
+			break;
+		}
+		printf(TAG ": step %u: done\n", step);
+		done = step;
+	}
+	/* 有些错误的写入要过十几秒才出事：最后几秒报活，日志末尾留着最后写了什么 */
+	for (uint32_t s = 1; s <= watch; s++) {
+		sleep_ms(1000);
+		printf(TAG ": alive %u s after step %u; %s\n", s, done, last_write);
+	}
+	gpu_block_stop();
+	printf(TAG ": over (got to step %u of %u); the system goes on\n", done, STEPS);
+}
