+++ b/bsd/dev/picasso_gauge.h
@@ -0,0 +1,203 @@
+/*
+ * picasso（红米 K30 5G）电量计算法：纯函数，不碰硬件，电脑上可以直接测试
+ * （tools/picasso-gauge-test.c）。使用前须已有 uint8_t/int16_t/uint16_t/int64_t 等类型。
+ *
+ * PM7250B 的 QGauge 只测电压和电流，百分比是 Linux 驱动（qpnp-qg.c）用电池曲线算出来的。
+ * 这里做一个简化版，照它的思路：
+ *   1. 开机：MIUI 关机时 QG 把电量存在 SDAM（0xb146 有效标志、0xb147 电量 %），和由当前电压
+ *      查表得到的电量相差不超过 PG_SDAM_TRUST 就用它；否则用“开路电压 → 电量”查表
+ *      （开路电压 ≈ 端电压 - 电流 × 电池内阻；内阻用 SDAM 里 QG 学到的值，不合理就用 150 mΩ）。
+ *   2. 运行：按电流积分（库仑计），容量用 SDAM 里 QG 学到的容量，不合理就用曲线里 25 °C 的满电容量。
+ *   3. 静置（|电流| < 30 mA 连续 5 分钟）：每次更新把电量向开路电压查表结果拉近 1/8，修正积分误差。
+ *   4. 充电器报“充满”就是 100%；充电中、没充满最多显示 99%；电压低于关机电压 3400 mV
+ *      （qcom,vbatt-cutoff-mv）时最多 1%。
+ * 电流方向用 IOPMPowerSource 的约定：正数 = 充电。温度没有测（用 25 °C）。
+ */
+#ifndef PICASSO_GAUGE_H
+#define PICASSO_GAUGE_H
+
+#include "picasso_gauge_lut.h"
+
+#define PG_DEFAULT_RBAT_MOHM  150
+#define PG_REST_MA            30
+#define PG_REST_MS            (5u * 60u * 1000u)
+#define PG_SDAM_TRUST         15      /* % */
+#define PG_CUTOFF_MV          3400
+#define PG_TEMP_DC            250     /* 0.1 °C */
+
+static inline int
+pg_lerp(int x, int x0, int y0, int x1, int y1)
+{
+	if (x1 == x0) {
+		return y0;
+	}
+	return y0 + (int)((int64_t)(x - x0) * (y1 - y0) / (x1 - x0));
+}
+
+/* 一列：OCV（0.1 mV）→ 电量（0.01%）。表按电量从高到低，OCV 也从高到低。 */
+static inline int
+pg_col_soc(const uint16_t *tab, int cols, int col, int ocv_dmv)
+{
+	if (ocv_dmv >= tab[col]) {
+		return pg_rows[0];
+	}
+	if (ocv_dmv <= tab[(PG_ROWS - 1) * cols + col]) {
+		return pg_rows[PG_ROWS - 1];
+	}
+	for (int i = 1; i < PG_ROWS; ++i) {
+		int hi = tab[(i - 1) * cols + col], lo = tab[i * cols + col];
+		if (ocv_dmv >= lo) {
+			return pg_lerp(ocv_dmv, lo, pg_rows[i], hi, pg_rows[i - 1]);
+		}
+	}
+	return pg_rows[PG_ROWS - 1];
+}
+
+/* 开路电压（µV）→ 电量（0.01%），温度 0.1 °C；与 qg_interpolate_soc 一样在两列温度之间插值 */
+static inline int
+pg_ocv_to_soc(int ocv_uv, int temp_dc, int charging)
+{
+	const uint16_t *tab = charging ? pg_v1 : pg_v2;
+	const int16_t *cols = charging ? pg_v1_cols : pg_v2_cols;
+	int n = charging ? PG_V1_COLS : PG_V2_COLS;
+	int ocv = ocv_uv / 100;
+	if (temp_dc <= cols[0] * 10) {
+		return pg_col_soc(tab, n, 0, ocv);
+	}
+	if (temp_dc >= cols[n - 1] * 10) {
+		return pg_col_soc(tab, n, n - 1, ocv);
+	}
+	int j = 1;
+	while (j < n - 1 && temp_dc > cols[j] * 10) {
+		++j;
+	}
+	int lo = pg_col_soc(tab, n, j - 1, ocv), hi = pg_col_soc(tab, n, j, ocv);
+	return pg_lerp(temp_dc, cols[j - 1] * 10, lo, cols[j] * 10, hi);
+}
+
+/* 满电容量（mAh）随温度 */
+static inline int
+pg_fcc(int temp_dc, int charging)
+{
+	const int16_t *cols = charging ? pg_fcc1_cols : pg_fcc2_cols;
+	const int16_t *v = charging ? pg_fcc1 : pg_fcc2;
+	int n = charging ? PG_FCC1_COLS : PG_FCC2_COLS;
+	if (temp_dc <= cols[0] * 10) {
+		return v[0];
+	}
+	for (int j = 1; j < n; ++j) {
+		if (temp_dc <= cols[j] * 10) {
+			return pg_lerp(temp_dc, cols[j - 1] * 10, v[j - 1], cols[j] * 10, v[j]);
+		}
+	}
+	return v[n - 1];
+}
+
+struct pg_state {
+	int64_t charge_uah;     /* 剩余电量 */
+	int fcc_mah;            /* 积分用的容量 */
+	int rbat_mohm;
+	unsigned rest_ms;
+	int started;
+	int source;             /* 1 = SDAM 存的电量，2 = 开路电压查表 */
+};
+
+static inline int
+pg_soc_from_voltage(const struct pg_state *s, int mv, int ma)
+{
+	/* 开路电压 ≈ 端电压 - 充电电流 × 内阻（放电时 ma 为负，端电压低于开路电压） */
+	int ocv_uv = mv * 1000 - (int)((int64_t)ma * s->rbat_mohm);
+	return pg_ocv_to_soc(ocv_uv, PG_TEMP_DC, ma > 0);
+}
+
+static inline void
+pg_set_soc(struct pg_state *s, int soc_cpct)
+{
+	if (soc_cpct < 0) {
+		soc_cpct = 0;
+	}
+	if (soc_cpct > 10000) {
+		soc_cpct = 10000;
+	}
+	s->charge_uah = (int64_t)soc_cpct * s->fcc_mah / 10;   /* mAh × 0.01% × 1000 µAh / 100 */
+}
+
+static inline int
+pg_soc(const struct pg_state *s)
+{
+	if (s->fcc_mah <= 0) {
+		return 0;
+	}
+	return (int)(s->charge_uah * 10 / s->fcc_mah);
+}
+
+/*
+ * 开机。sdam_valid/sdam_soc：SDAM 0xb146/0xb147；rbat_mohm：0xb14a；learned_mah：0xb168
+ * （读不到填 0）。返回初始电量（0.01%）。
+ */
+static inline int
+pg_start(struct pg_state *s, int mv, int ma, int sdam_valid, int sdam_soc,
+    int rbat_mohm, int learned_mah)
+{
+	int fcc = pg_fcc(PG_TEMP_DC, 0);
+	s->fcc_mah = (learned_mah >= fcc * 6 / 10 && learned_mah <= fcc * 11 / 10) ? learned_mah : fcc;
+	s->rbat_mohm = (rbat_mohm >= 30 && rbat_mohm <= 600) ? rbat_mohm : PG_DEFAULT_RBAT_MOHM;
+	s->rest_ms = 0;
+	int vsoc = pg_soc_from_voltage(s, mv, ma);
+	int d = sdam_soc * 100 - vsoc;
+	if (sdam_valid == 1 && sdam_soc >= 0 && sdam_soc <= 100 &&
+	    d <= PG_SDAM_TRUST * 100 && d >= -PG_SDAM_TRUST * 100) {
+		pg_set_soc(s, sdam_soc * 100);
+		s->source = 1;
+	} else {
+		pg_set_soc(s, vsoc);
+		s->source = 2;
+	}
+	s->started = 1;
+	return pg_soc(s);
+}
+
+/* 每次采样调用一次。dt_ms：距上次的时间；full：充电器报充满。返回显示的百分比 0..100。 */
+static inline unsigned
+pg_update(struct pg_state *s, int mv, int ma, unsigned dt_ms, int charging, int full)
+{
+	if (!s->started) {
+		return 0;
+	}
+	/* 一次最多积 10 分钟：睡眠或卡顿后不让一个异常电流积出大跳变 */
+	if (dt_ms > 600000u) {
+		dt_ms = 600000u;
+	}
+	s->charge_uah += (int64_t)ma * dt_ms / 3600;   /* mA × ms / 3600 = µAh */
+	if (ma < PG_REST_MA && ma > -PG_REST_MA) {
+		s->rest_ms = s->rest_ms + dt_ms > PG_REST_MS * 4u ? PG_REST_MS * 4u : s->rest_ms + dt_ms;
+	} else {
+		s->rest_ms = 0;
+	}
+	if (s->rest_ms >= PG_REST_MS) {
+		int target = pg_soc_from_voltage(s, mv, ma);
+		pg_set_soc(s, pg_soc(s) + (target - pg_soc(s)) / 8);
+	}
+	if (full) {
+		pg_set_soc(s, 10000);
+	}
+	int soc = pg_soc(s);
+	if (soc < 0) {
+		pg_set_soc(s, 0);
+		soc = 0;
+	}
+	if (soc > 10000) {
+		pg_set_soc(s, 10000);
+		soc = 10000;
+	}
+	unsigned pct = (unsigned)((soc + 50) / 100);
+	if (charging && !full && pct > 99) {
+		pct = 99;
+	}
+	if (!charging && mv > 0 && mv < PG_CUTOFF_MV && pct > 1) {
+		pct = 1;
+	}
+	return pct;
+}
+
+#endif /* PICASSO_GAUGE_H */
