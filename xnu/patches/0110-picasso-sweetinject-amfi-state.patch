+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * SWEET: boot-arg sweetinject=LIBRARY:NAME[,NAME...][;LIBRARY:NAME[,NAME...]]...
+ * -- 文件名是某个 NAME 的程序启动时，环境里多一个 DYLD_INSERT_LIBRARIES=LIBRARY（该组的库），
+ * 比如把 CoreAnimation 桥插进 backboardd。launchd 会把任务描述里的 DYLD_ 变量丢掉，所以由内核来加；
+ * dyld 肯听是因为 bsd/kern/sweet_amfi.c 的 "AMFI" 策略对它的询问一律放行。
+ * 默认没有这个 boot-arg = 什么都不插。第一个点名这个程序的组生效。
+ * 来自 ios-apollo 0114（MIT），再往前是 HackiOS 的 kern.exec_inject（bsd/kern/kern_exec.c）。
+ */
+static bool
+sweet_exec_inject(struct image_params *imgp, char *env, size_t size)
+{
+	char conf[200];
+	const char *path = imgp->ip_strings + strlen(EXECUTABLE_KEY), *name = path;
+	size_t namelen;
+
+	if (!PE_parse_boot_argn("sweetinject", conf, sizeof(conf)) ||
+	    strncmp(imgp->ip_strings, EXECUTABLE_KEY, strlen(EXECUTABLE_KEY)) != 0) {
+		return false;
+	}
+	for (const char *c = path; *c != 0; c++) {
+		if (*c == '/') {
+			name = c + 1;
+		}
+	}
+	namelen = strlen(name);
+	if (namelen == 0) {
+		return false;
+	}
+	for (const char *group = conf; *group != 0;) {
+		const char *lib = group, *word;
+		size_t grouplen = 0, liblen = 0;
+
+		while (group[grouplen] != 0 && group[grouplen] != ';') {
+			grouplen++;
+		}
+		while (liblen < grouplen && lib[liblen] != ':') {
+			liblen++;
+		}
+		for (word = lib + liblen + 1; liblen != 0 && liblen < grouplen && word < group + grouplen;) {
+			size_t len = 0;
+
+			while (word + len < group + grouplen && word[len] != ',') {
+				len++;
+			}
+			if (len == namelen && strncmp(word, name, len) == 0) {
+				snprintf(env, size, "DYLD_INSERT_LIBRARIES=%.*s", (int)liblen, lib);
+				return true;
+			}
+			word += len + (word + len < group + grouplen && word[len] == ',');
+		}
+		group += grouplen + (group[grouplen] == ';');
+	}
+	return false;
+}
