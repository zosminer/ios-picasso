+/* 结束端点 ep 上正在进行的传输（如果有）。 */
+static void
+ud_end_transfer(unsigned ep)
+{
+	if (ep <= EP_INT && ud.xfer_active[ep]) {
+		ud_epcmd(ep, DEPCMD_ENDTRANSFER | DEPCMD_HIPRI_FORCERM | ((uint32_t)ud.xfer_rsc[ep] << 16), 0, 0, 0);
+		delay(100);
+		ud.xfer_active[ep] = false;
+	}
 }
 
