+/* 总线复位（主机的，或 usbipd 的）会丢掉控制器里数据端点的配置。以前只把地址清零，端点这边还当
+ * "已配置"，下一次 SET_CONFIGURATION 什么都没配、发送中的帧让 tx_busy 一直占着，于是 ue0 要重启才好。
+ * 照 Linux dwc3_gadget_reset_interrupt：结束数据端点传输、忘掉配置和队列、把卡在半截的控制传输
+ * 重新挂上（sapphire 0159/0162）。 */
+static void
+ud_bus_reset(void)
+{
+	for (unsigned ep = EP_RX; ep <= EP_INT; ep++) {
+		ud_end_transfer(ep);
+	}
+	dwc_wr(DALEPENA, dwc_rd(DALEPENA) & ~((1u << EP_RX) | (1u << EP_TX) | (1u << EP_INT)));
+	if (ud.lock != NULL) {
+		lck_mtx_lock(ud.lock);
+	}
+	ud.configured = false;
+	ud.data_alt = 0;
+	ud.tx_busy = false;
+	while (ud.txq_count > 0) {
+		mbuf_freem(ud.txq[ud.txq_head]);
+		ud.txq_head = (ud.txq_head + 1) % UD_TXQ;
+		ud.txq_count--;
+	}
+	if (ud.lock != NULL) {
+		lck_mtx_unlock(ud.lock);
+	}
+	/* ep0：已经在等的 SETUP 留着；卡在半截的控制传输两个方向都结束掉再重新挂（Linux dwc3_ep0_end_control_data） */
+	if (ud.state != EP0_SETUP || !ud.xfer_active[0]) {
+		ud_end_transfer(0);
+		ud_end_transfer(1);
+		ud_start_setup();
+	}
+}
